ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.9.28@sha256:b400c36bce7aa9a84965ad23d0e4339ccffaaa06e825d08b064a0f40a2eb90ab
ARG PYTHON_BASE_IMAGE=python:3.14.2-slim-bookworm@sha256:977174a93ac5b559a077d2e2997bfde0d9b2c0e283a3fddb12747e35aea43689

FROM ${UV_IMAGE} AS uv
FROM ${PYTHON_BASE_IMAGE}

ARG RUNTIME_SOURCE_COMMIT
ARG RUNTIME_SOURCE_SHA256
LABEL org.opencontainers.image.revision="${RUNTIME_SOURCE_COMMIT}"
LABEL com.esan.gbos.runtime-source-sha256="${RUNTIME_SOURCE_SHA256}"

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_PROGRESS=1

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 gbos \
    && useradd --uid 10001 --gid gbos --create-home --shell /usr/sbin/nologin gbos

COPY --from=uv /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project \
    && chown -R gbos:gbos /app

COPY --chown=gbos:gbos services ./services
COPY --chown=gbos:gbos contracts ./contracts

USER gbos

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["python", "-c", "import os; os.kill(1, 0)"]

CMD ["python", "-c", "raise SystemExit(78)"]
