{
  "doctype": "DocType",
  "name": "GBOS Work Item",
  "module": "GBOS",
  "engine": "InnoDB",
  "track_changes": 1,
  "title_field": "title",
  "field_order": ["title", "team", "assigned_to", "priority", "due_date", "reference_doctype", "reference_name", "blocked_reason", "origin", "origin_reference", "business_status", "review_status", "revision", "last_request_id"],
  "fields": [
    {"fieldname": "title", "label": "Title", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "team", "label": "Team", "fieldtype": "Link", "options": "GBOS Team", "reqd": 1, "in_standard_filter": 1},
    {"fieldname": "assigned_to", "label": "Assigned To", "fieldtype": "Link", "options": "User", "in_standard_filter": 1},
    {"fieldname": "priority", "label": "Priority", "fieldtype": "Select", "options": "Low\nMedium\nHigh\nUrgent", "default": "Medium", "in_standard_filter": 1},
    {"fieldname": "due_date", "label": "Due Date", "fieldtype": "Date"},
    {"fieldname": "reference_doctype", "label": "Reference DocType", "fieldtype": "Link", "options": "DocType"},
    {"fieldname": "reference_name", "label": "Reference Name", "fieldtype": "Dynamic Link", "options": "reference_doctype"},
    {"fieldname": "blocked_reason", "label": "Blocked Reason", "fieldtype": "Small Text"},
    {"fieldname": "origin", "label": "Origin", "fieldtype": "Select", "options": "Manual\nFixture\nIntegration\nAI", "default": "Manual", "reqd": 1},
    {"fieldname": "origin_reference", "label": "Origin Reference", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "business_status", "label": "Business Status", "fieldtype": "Select", "options": "Open\nIn Progress\nBlocked\nDone\nCancelled", "default": "Open", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "review_status", "label": "Review Status", "fieldtype": "Select", "options": "AI Draft\nPending\nApproved\nRejected\nSuperseded", "default": "Pending", "reqd": 1},
    {"fieldname": "revision", "label": "Revision", "fieldtype": "Int", "default": "0", "read_only": 1},
    {"fieldname": "last_request_id", "label": "Last Request ID", "fieldtype": "Data", "read_only": 1}
  ],
  "permissions": [{"role": "GBOS Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1}]
}
