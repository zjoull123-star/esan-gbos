    {"fieldname": "lead_time_days", "label": "Lead Time Days", "fieldtype": "Int"},
    {"fieldname": "candidate_status", "label": "Candidate Status", "fieldtype": "Select", "options": "Invited\nResponded\nShortlisted\nSelected\nRejected", "default": "Invited", "in_list_view": 1},
