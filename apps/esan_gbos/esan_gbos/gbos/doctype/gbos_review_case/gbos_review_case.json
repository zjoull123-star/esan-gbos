{
  "doctype": "DocType",
  "name": "GBOS Review Case",
  "module": "GBOS",
  "engine": "InnoDB",
  "track_changes": 1,
  "title_field": "title",
  "field_order": ["title", "team", "assigned_reviewer", "subject_doctype", "subject_name", "subject_revision", "subject_payload_sha256", "subject_snapshot", "case_payload_sha256", "evidence_refs", "policy_version", "approval_expires_at", "decision_note", "decided_by", "decided_at", "decision_record", "decision_payload_sha256", "approved_command", "command_publication", "origin", "origin_reference", "business_status", "review_status", "revision", "last_request_id"],
  "fields": [
    {"fieldname": "title", "label": "Title", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "team", "label": "Team", "fieldtype": "Link", "options": "GBOS Team", "reqd": 1},
    {"fieldname": "assigned_reviewer", "label": "Assigned Reviewer", "fieldtype": "Link", "options": "User", "reqd": 1, "in_standard_filter": 1},
    {"fieldname": "subject_doctype", "label": "Subject DocType", "fieldtype": "Link", "options": "DocType", "reqd": 1},
    {"fieldname": "subject_name", "label": "Subject Name", "fieldtype": "Dynamic Link", "options": "subject_doctype", "reqd": 1},
    {"fieldname": "subject_revision", "label": "Subject Revision", "fieldtype": "Int", "read_only": 1},
    {"fieldname": "subject_payload_sha256", "label": "Subject Payload SHA-256", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "subject_snapshot", "label": "Frozen Subject Snapshot", "fieldtype": "Code", "options": "JSON", "read_only": 1},
    {"fieldname": "case_payload_sha256", "label": "Case Payload SHA-256", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "evidence_refs", "label": "Evidence References", "fieldtype": "Code", "options": "JSON", "read_only": 1},
    {"fieldname": "policy_version", "label": "Policy Version", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "approval_expires_at", "label": "Approval Expires At", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "decision_note", "label": "Decision Note", "fieldtype": "Small Text", "read_only": 1},
    {"fieldname": "decided_by", "label": "Decided By", "fieldtype": "Link", "options": "User", "read_only": 1},
    {"fieldname": "decided_at", "label": "Decided At", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "decision_record", "label": "Decision Record", "fieldtype": "Link", "options": "GBOS Review Decision", "read_only": 1},
    {"fieldname": "decision_payload_sha256", "label": "Decision Payload SHA-256", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "approved_command", "label": "Approved Command", "fieldtype": "Link", "options": "GBOS Approved Command", "read_only": 1},
    {"fieldname": "command_publication", "label": "Command Publication", "fieldtype": "Link", "options": "GBOS Command Publication", "read_only": 1},
    {"fieldname": "origin", "label": "Origin", "fieldtype": "Select", "options": "Manual\nFixture\nIntegration\nAI", "default": "Manual", "reqd": 1},
    {"fieldname": "origin_reference", "label": "Origin Reference", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "business_status", "label": "Business Status", "fieldtype": "Select", "options": "Pending\nApproved\nRejected\nSuperseded", "default": "Pending", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "review_status", "label": "Review Status", "fieldtype": "Select", "options": "AI Draft\nPending\nApproved\nRejected\nSuperseded", "default": "Pending", "reqd": 1},
    {"fieldname": "revision", "label": "Revision", "fieldtype": "Int", "default": "0", "read_only": 1},
    {"fieldname": "last_request_id", "label": "Last Request ID", "fieldtype": "Data", "read_only": 1}
  ],
  "permissions": [
    {"role": "GBOS Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
    {"role": "Agent TrustedMaterializer", "write": 1, "create": 1}
  ]
}
