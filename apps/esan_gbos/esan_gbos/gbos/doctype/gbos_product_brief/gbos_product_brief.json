{
  "doctype": "DocType",
  "name": "GBOS Product Brief",
  "module": "GBOS",
  "engine": "InnoDB",
  "track_changes": 1,
  "title_field": "title",
  "field_order": ["title", "team", "party_profile", "deal", "description", "target_quantity", "target_uom", "target_date", "origin", "origin_reference", "business_status", "review_status", "revision", "last_request_id"],
  "fields": [
    {"fieldname": "title", "label": "Title", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "team", "label": "Team", "fieldtype": "Link", "options": "GBOS Team", "reqd": 1},
    {"fieldname": "party_profile", "label": "Party Profile", "fieldtype": "Link", "options": "GBOS Party Profile"},
    {"fieldname": "deal", "label": "CRM Deal", "fieldtype": "Link", "options": "CRM Deal"},
    {"fieldname": "description", "label": "Description", "fieldtype": "Text Editor"},
    {"fieldname": "target_quantity", "label": "Target Quantity", "fieldtype": "Float"},
    {"fieldname": "target_uom", "label": "Target UOM", "fieldtype": "Link", "options": "UOM"},
    {"fieldname": "target_date", "label": "Target Date", "fieldtype": "Date"},
    {"fieldname": "origin", "label": "Origin", "fieldtype": "Select", "options": "Manual\nFixture\nIntegration\nAI", "default": "Manual", "reqd": 1},
    {"fieldname": "origin_reference", "label": "Origin Reference", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "business_status", "label": "Business Status", "fieldtype": "Select", "options": "Draft\nActive\nArchived", "default": "Draft", "reqd": 1},
    {"fieldname": "review_status", "label": "Review Status", "fieldtype": "Select", "options": "AI Draft\nPending\nApproved\nRejected\nSuperseded", "default": "Pending", "reqd": 1},
    {"fieldname": "revision", "label": "Revision", "fieldtype": "Int", "default": "0", "read_only": 1},
    {"fieldname": "last_request_id", "label": "Last Request ID", "fieldtype": "Data", "read_only": 1}
  ],
  "permissions": [
    {"role": "GBOS Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
    {"role": "Agent TrustedMaterializer", "read": 1}
  ]
}
