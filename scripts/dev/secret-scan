#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(CDPATH= cd -- "${SCRIPT_DIR}/../.." && pwd -P)"
export PATH="${HOME}/.orbstack/bin:${PATH}"

SECRET_PATTERN='-----BEGIN [A-Z ]+PRIVATE KEY-----|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9_]{30,}|github_pat_[A-Za-z0-9_]{40,}|xox[baprs]-[A-Za-z0-9-]{20,}|sk_live_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{35}'
found=0

while IFS= read -r -d '' file; do
  case "${file}" in
    .env|*/.env)
      echo "Refusing committed or unignored environment file: ${file}" >&2
      found=1
      continue
      ;;
  esac

  if LC_ALL=C grep -EInIH -- "${SECRET_PATTERN}" "${REPO_ROOT}/${file}"; then
    found=1
  fi
done < <(git -C "${REPO_ROOT}" ls-files -co --exclude-standard -z)

if (( found != 0 )); then
  echo "Potential secret material detected." >&2
  exit 1
fi

echo "No supported secret patterns detected."
