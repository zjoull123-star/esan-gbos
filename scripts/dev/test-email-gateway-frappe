#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC1007  # CDPATH is intentionally scoped to the cd command.
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck disable=SC1007  # CDPATH is intentionally scoped to the cd command.
REPO_ROOT="$(CDPATH= cd -- "${SCRIPT_DIR}/../.." && pwd -P)"
RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/gbos-email-authority.XXXXXX")"
RUN_SUFFIX="$(basename "${RUN_DIR}" | tr '[:upper:].' '[:lower:]-')-$$"
PROJECT_NAME="gbos-email-send-${RUN_SUFFIX}"
SITE_NAME="email-send-${RUN_SUFFIX}.localhost"
ENV_FILE="${RUN_DIR}/compose.env"
OVERRIDE_FILE="${RUN_DIR}/current-source.yml"
COMPOSE_FILE="${REPO_ROOT}/infra/dev/compose.yml"

cleanup() {
  docker compose \
    --project-name "${PROJECT_NAME}" \
    --env-file "${ENV_FILE}" \
    -f "${COMPOSE_FILE}" \
    -f "${OVERRIDE_FILE}" \
    --profile core \
    down --volumes --remove-orphans >/dev/null 2>&1 || true
  rm -rf -- "${RUN_DIR}"
}
trap cleanup EXIT INT TERM

umask 077
printf '%s\n' \
  "DB_ROOT_PASSWORD=authority-db-${RUN_SUFFIX}" \
  "ADMIN_PASSWORD=authority-admin-${RUN_SUFFIX}" \
  "OBSERVER_POSTGRES_PASSWORD=authority-observer-${RUN_SUFFIX}" \
  "SITE_NAME=${SITE_NAME}" \
  "APP_LIST=erpnext,crm,esan_gbos" \
  "GBOS_IMAGE_STAGE=final" \
  "GBOS_PRODUCTION_ENABLED=false" \
  "GBOS_LOAD_DEMO_FIXTURES=false" \
  "ERPNEXT_IMAGE=${GBOS_EMAIL_AUTHORITY_FRAPPE_IMAGE:-esan-gbos-final:gate1}" \
  >"${ENV_FILE}"

printf '%s\n' \
  'services:' \
  '  backend:' \
  '    volumes:' \
  '      - sites:/home/frappe/frappe-bench/sites' \
  '      - logs:/home/frappe/frappe-bench/logs' \
  "      - ${REPO_ROOT}/apps/esan_gbos:/home/frappe/frappe-bench/apps/esan_gbos:ro" \
  'networks:' \
  '  default:' \
  '    internal: true' \
  >"${OVERRIDE_FILE}"

compose() {
  docker compose \
    --project-name "${PROJECT_NAME}" \
    --env-file "${ENV_FILE}" \
    -f "${COMPOSE_FILE}" \
    -f "${OVERRIDE_FILE}" \
    "$@"
}

compose --profile core up -d db redis-cache redis-queue
compose --profile core run --rm configurator
# shellcheck disable=SC2016  # Variables expand inside the container shell.
compose --profile core run --rm --no-deps \
  -e SITE_NAME="${SITE_NAME}" \
  -e DB_ROOT_PASSWORD="authority-db-${RUN_SUFFIX}" \
  -e ADMIN_PASSWORD="authority-admin-${RUN_SUFFIX}" \
  backend /bin/sh -eu -c '
    touch sites/apps.txt
    for app in erpnext crm esan_gbos; do
      grep -Fxq "$app" sites/apps.txt || printf "%s\n" "$app" >> sites/apps.txt
    done
    bench new-site "$SITE_NAME" \
      --mariadb-user-host-login-scope="%" \
      --db-root-username=root \
      --db-root-password="$DB_ROOT_PASSWORD" \
      --admin-password="$ADMIN_PASSWORD" \
      --set-default
    bench --site "$SITE_NAME" install-app erpnext
    bench --site "$SITE_NAME" install-app crm
    bench --site "$SITE_NAME" install-app esan_gbos
    bench --site "$SITE_NAME" set-config allow_tests true
    bench --site "$SITE_NAME" migrate
    bench --site "$SITE_NAME" migrate
    bench --site "$SITE_NAME" run-tests --module esan_gbos.gbos.doctype.gbos_party_profile.test_gbos_party_profile --skip-test-records
    bench --site "$SITE_NAME" run-tests --module esan_gbos.gbos.doctype.gbos_external_identity.test_gbos_external_identity --skip-test-records
    bench --site "$SITE_NAME" run-tests --module esan_gbos.gbos.doctype.gbos_email_send_approval.test_gbos_email_send_approval --skip-test-records
    bench --site "$SITE_NAME" run-tests --module esan_gbos.gbos.doctype.gbos_approved_command.test_gbos_approved_command --skip-test-records
    bench --site "$SITE_NAME" run-tests --module esan_gbos.gbos.doctype.gbos_command_publication.test_gbos_command_publication --skip-test-records
    bench --site "$SITE_NAME" execute esan_gbos.api.internal.email_command_publication._now >/dev/null
    bench --site "$SITE_NAME" execute esan_gbos.install.ensure_roles >/dev/null
  '
