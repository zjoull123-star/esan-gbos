#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(CDPATH= cd -- "${SCRIPT_DIR}/../.." && pwd -P)"
export PATH="${HOME}/.orbstack/bin:${PATH}"

ENV_FILE="${REPO_ROOT}/infra/dev/.env"
if [[ ! -f "${ENV_FILE}" ]]; then
  cp -- "${REPO_ROOT}/infra/dev/.env.example" "${ENV_FILE}"
  chmod 600 "${ENV_FILE}"
fi
if grep -Eiq \
  '^(GBOS_PRODUCTION_ENABLED=(true|1|yes)|GBOS_ENV=production)$' \
  "${ENV_FILE}"; then
  echo "Gate 5 integration tests refuse production configuration." >&2
  exit 78
fi

set -a
# shellcheck disable=SC1090
source "${ENV_FILE}"
set +a
export GBOS_PRODUCTION_ENABLED=false
export GBOS_RUN_GATE5_POSTGRES_INTEGRATION=1
export GBOS_GATE5_METRICS_DSN="$(
  python3 -c 'import os, urllib.parse; print("postgresql://gbos_metrics_app:" + urllib.parse.quote(os.environ["OBSERVER_POSTGRES_PASSWORD"], safe="") + "@127.0.0.1:" + os.environ["OBSERVER_POSTGRES_PORT"] + "/" + os.environ["OBSERVER_POSTGRES_DB"])'
)"

"${SCRIPT_DIR}/gate5-migrate"
"${SCRIPT_DIR}/gate5-migrate"

cd "${REPO_ROOT}"
PYTHONDONTWRITEBYTECODE=1 \
  uv run --frozen --no-sync \
  pytest -p no:cacheprovider \
  tests/integration/test_gate5_metrics_postgres.py -q
