#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(CDPATH= cd -- "${SCRIPT_DIR}/../.." && pwd -P)"
export PATH="${HOME}/.orbstack/bin:${PATH}"

TRIVY_IMAGE="aquasec/trivy:0.73.0@sha256:7cced7cae583819fc7806d4cbc0dbbc7cad18b99f7d3e235192e6da8c091045c"
OUTPUT_DIR="${1:-${TMPDIR:-/tmp}/esan-gbos-sbom}"
TARGET_IMAGE="${2:-}"
NON_RUNTIME_JAR="usr/share/java/libintl-0.21.jar"

mkdir -p -- "${OUTPUT_DIR}"
OUTPUT_DIR="$(CDPATH= cd -- "${OUTPUT_DIR}" && pwd -P)"

if [[ -z "${TARGET_IMAGE}" ]]; then
  docker run --rm \
    -v "${REPO_ROOT}:/workspace:ro" \
    -v "${OUTPUT_DIR}:/output" \
    -w /workspace \
    "${TRIVY_IMAGE}" \
    fs --scanners license --format json --output /output/licenses.json .
  docker run --rm \
    -v "${REPO_ROOT}:/workspace:ro" \
    -v "${OUTPUT_DIR}:/output" \
    -w /workspace \
    "${TRIVY_IMAGE}" \
    fs --format cyclonedx --output /output/sbom.cdx.json .
else
  TARGET_DIGEST="$(docker image inspect "${TARGET_IMAGE}" --format '{{.Id}}')"
  docker run --rm \
    -v /var/run/docker.sock:/var/run/docker.sock:ro \
    -v "${OUTPUT_DIR}:/output" \
    "${TRIVY_IMAGE}" \
    image \
    --scanners license \
    --skip-files "${NON_RUNTIME_JAR}" \
    --format json \
    --output /output/licenses.json \
    "${TARGET_DIGEST}"
  docker run --rm \
    -v /var/run/docker.sock:/var/run/docker.sock:ro \
    -v "${OUTPUT_DIR}:/output" \
    "${TRIVY_IMAGE}" \
    image \
    --skip-files "${NON_RUNTIME_JAR}" \
    --format cyclonedx \
    --output /output/sbom.cdx.json \
    "${TARGET_DIGEST}"
fi

(
  cd "${OUTPUT_DIR}"
  shasum -a 256 licenses.json sbom.cdx.json > SHA256SUMS
)
echo "Wrote license inventory, CycloneDX SBOM, and checksums to ${OUTPUT_DIR}."
