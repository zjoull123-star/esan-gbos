#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

ACKNOWLEDGE_REAL="false"
ENABLE_RETENTION="false"
ACKNOWLEDGE_RETENTION="false"
CANARY_DIR=""
while (( $# > 0 )); do
  case "$1" in
    --acknowledge-real-email-and-model)
      ACKNOWLEDGE_REAL="true"
      ;;
    --enable-retention-scheduler)
      ENABLE_RETENTION="true"
      ;;
    --acknowledge-periodic-expired-local-data-deletion)
      ACKNOWLEDGE_RETENTION="true"
      ;;
    --canary-dir)
      [[ $# -ge 2 ]] || { echo "--canary-dir requires a path" >&2; exit 64; }
      CANARY_DIR="$2"
      shift
      ;;
    *)
      echo "Unknown canary start argument." >&2
      exit 64
      ;;
  esac
  shift
done

if [[ "${ACKNOWLEDGE_REAL}" != "true" || "${ENABLE_RETENTION}" != "true" || "${ACKNOWLEDGE_RETENTION}" != "true" || -z "${CANARY_DIR}" ]]; then
  echo "Usage: scripts/local-pilot/start-email-deepseek-canary --acknowledge-real-email-and-model --enable-retention-scheduler --acknowledge-periodic-expired-local-data-deletion --canary-dir PATH" >&2
  exit 64
fi

if [[ ! -d "${CANARY_DIR}" || -L "${CANARY_DIR}" ]]; then
  echo "Canary directory must be a real directory." >&2
  exit 78
fi
MANIFEST="${CANARY_DIR}/pilot-manifest.json"
CONTROL="${CANARY_DIR}/canary-run.json"
if [[ ! -f "${MANIFEST}" || -L "${MANIFEST}" || ! -f "${CONTROL}" || -L "${CONTROL}" ]]; then
  echo "Prepared canary controls are unavailable." >&2
  exit 78
fi

exec "${SCRIPT_DIR}/start" \
  --manifest "${MANIFEST}" \
  --canary-control "${CONTROL}" \
  --enable-retention-scheduler \
  --acknowledge-periodic-expired-local-data-deletion
