#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ "${GBOS_PRODUCTION_ENABLED:-false}" =~ ^(true|1|yes)$ ]]; then
  echo "Local-pilot migration refuses production mode." >&2
  exit 78
fi
if [[ "${1:-}" != "--inside-container" || $# -ne 1 ]]; then
  echo "Usage: scripts/local-pilot/migrate --inside-container" >&2
  exit 64
fi

for secret_file in \
  /run/secrets/postgres_password \
  /run/secrets/postgres_app_password; do
  [[ -f "${secret_file}" && ! -L "${secret_file}" && -s "${secret_file}" ]] || {
    echo "Required migration secret is unavailable: ${secret_file}" >&2
    exit 78
  }
done

pgpass_file=/tmp/local-pilot.pgpass
printf '%s:%s:%s:%s:%s\n' \
  "${POSTGRES_HOST:-postgres}" \
  "${POSTGRES_PORT:-5432}" \
  "${POSTGRES_DB:-gbos_local_pilot}" \
  "${POSTGRES_USER:-gbos_local_pilot}" \
  "$(< /run/secrets/postgres_password)" > "${pgpass_file}"
chmod 600 "${pgpass_file}"
export PGPASSFILE="${pgpass_file}"

PSQL=(
  psql
  -h "${POSTGRES_HOST:-postgres}"
  -p "${POSTGRES_PORT:-5432}"
  -U "${POSTGRES_USER:-gbos_local_pilot}"
  -d "${POSTGRES_DB:-gbos_local_pilot}"
  -v ON_ERROR_STOP=1
  -X
)

"${PSQL[@]}" <<'SQL'
CREATE SCHEMA IF NOT EXISTS observer;
CREATE TABLE IF NOT EXISTS observer.schema_migrations (
  migration_name text PRIMARY KEY,
  checksum char(64) NOT NULL,
  applied_at timestamptz NOT NULL DEFAULT now()
);
SQL

apply_migration() {
  local migration="$1"
  local group name checksum existing transaction_input
  [[ -f "${migration}" ]] || {
    echo "Migration is missing: ${migration}" >&2
    exit 66
  }
  group="$(basename -- "$(dirname -- "${migration}")")"
  name="${group}/$(basename -- "${migration}")"
  [[ "${name}" =~ ^[a-z0-9._/-]+$ ]] || {
    echo "Unsafe migration name: ${name}" >&2
    exit 65
  }
  checksum="$(sha256sum "${migration}" | awk '{print $1}')"
  existing="$("${PSQL[@]}" -Atqc \
    "SELECT checksum FROM observer.schema_migrations WHERE migration_name = '${name}'")"
  if [[ -n "${existing}" ]]; then
    [[ "${existing}" == "${checksum}" ]] || {
      echo "Applied migration checksum changed: ${name}" >&2
      exit 65
    }
    return
  fi

  transaction_input="${migration}"
  if [[ "${group}" == "media" ]]; then
    transaction_input="/tmp/$(basename -- "${migration}")"
    sed -e '/^[[:space:]]*BEGIN;[[:space:]]*$/d' \
      -e '/^[[:space:]]*COMMIT;[[:space:]]*$/d' \
      "${migration}" > "${transaction_input}"
    chmod 600 "${transaction_input}"
  fi
  "${PSQL[@]}" --single-transaction \
    -f "${transaction_input}" \
    -c "INSERT INTO observer.schema_migrations (migration_name, checksum)
        VALUES ('${name}', '${checksum}')"
}

# The frozen dependency order is observer context agent media. Each path is
# checksum-ledgered before later groups are considered.
for migration_group in observer context agent media; do
  case "${migration_group}" in
    observer) migration_glob=(/migrations/observer/[0-9][0-9][0-9]_*.sql) ;;
    context) migration_glob=(/migrations/context/[0-9][0-9][0-9]_*.sql) ;;
    agent) migration_glob=(/migrations/agent/[0-9][0-9][0-9]_*.sql) ;;
    media) migration_glob=(/migrations/media/[0-9][0-9][0-9]_*.sql) ;;
  esac
  ((${#migration_glob[@]} > 0)) || {
    echo "No ${migration_group} migrations were mounted." >&2
    exit 66
  }
  for migration in "${migration_glob[@]}"; do
    apply_migration "${migration}"
  done
done

# Migrations intentionally define NOLOGIN roles. Local composition enables
# exactly four application identities only after the full chain succeeds.
"${PSQL[@]}" <<'SQL'
SELECT format(
  'CREATE ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS PASSWORD %L',
  role_name,
  pg_read_file('/run/secrets/postgres_app_password')
)
FROM (
  VALUES
    ('gbos_observer_app'),
    ('gbos_context_app'),
    ('gbos_agent_app'),
    ('gbos_media_app')
) AS roles(role_name)
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = role_name)
\gexec

ALTER ROLE gbos_observer_app
  LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS;
ALTER ROLE gbos_context_app
  LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS;
ALTER ROLE gbos_agent_app
  LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS;
ALTER ROLE gbos_media_app
  LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS;

SELECT format(
  'ALTER ROLE %I PASSWORD %L',
  role_name,
  pg_read_file('/run/secrets/postgres_app_password')
)
FROM (
  VALUES
    ('gbos_observer_app'),
    ('gbos_context_app'),
    ('gbos_agent_app'),
    ('gbos_media_app')
) AS roles(role_name)
\gexec

GRANT USAGE ON SCHEMA media_runtime TO gbos_media_app;
GRANT SELECT, INSERT, UPDATE ON media_runtime.local_media_jobs TO gbos_media_app;
SQL

echo "Local-pilot observer/context/agent/media migrations are checksum-consistent."
