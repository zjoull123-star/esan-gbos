#!/usr/bin/env python3
"""Launch the Email checkpoint probe with its repository-bound Python."""

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
PYTHON = ROOT / ".venv" / "bin" / "python"
MODULE = ROOT / "services" / "local_pilot_runtime" / "email_checkpoint_probe.py"

os.execv(str(PYTHON), [str(PYTHON), str(MODULE), *sys.argv[1:]])
