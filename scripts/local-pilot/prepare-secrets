#!/usr/bin/env bash
set -euo pipefail
umask 077

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/lib.sh"

MANIFEST="${DEFAULT_MANIFEST}"
while (( $# > 0 )); do
  case "$1" in
    --manifest)
      [[ $# -ge 2 ]] || { echo "--manifest requires a path" >&2; exit 64; }
      MANIFEST="$2"
      shift
      ;;
    *)
      echo "Usage: scripts/local-pilot/prepare-secrets [--manifest PATH]" >&2
      exit 64
      ;;
  esac
  shift
done

[[ -f "${MANIFEST}" ]] || { echo "Manifest is missing: ${MANIFEST}" >&2; exit 66; }
[[ -x /usr/bin/security ]] || { echo "macOS Keychain CLI is unavailable." >&2; exit 69; }

secret_tmp_root="${TMPDIR:-/tmp}"
secret_tmp_root="${secret_tmp_root%/}"
secret_dir="$(mktemp -d "${secret_tmp_root}/gbos-local-pilot-secrets.XXXXXX")"
completed=false
cleanup_on_error() {
  if [[ "${completed}" != "true" && -d "${secret_dir}" ]]; then
    rm -f -- "${secret_dir}"/*
    rmdir -- "${secret_dir}"
  fi
}
trap cleanup_on_error EXIT HUP INT TERM

write_keychain_secret() {
  local output_name="$1"
  local keychain_ref="$2"
  local remainder service account secret_value
  case "${keychain_ref}" in
    keychain://*/*) ;;
    *)
      echo "Invalid Keychain reference for ${output_name}." >&2
      return 78
      ;;
  esac
  remainder="${keychain_ref#keychain://}"
  service="${remainder%%/*}"
  account="${remainder#*/}"
  if [[ ! "${service}" =~ ^[A-Za-z0-9._-]+$ ]] ||
    [[ ! "${account}" =~ ^[A-Za-z0-9._/-]+$ ]] ||
    [[ "${account}" == *".."* ]]; then
    echo "Unsafe Keychain reference for ${output_name}." >&2
    return 78
  fi
  if ! secret_value="$(
    /usr/bin/security find-generic-password \
      -s "${service}" \
      -a "${account}" \
      -w
  )"; then
    echo "Required Keychain item is unavailable for ${output_name}." >&2
    return 78
  fi
  [[ -n "${secret_value}" ]] || {
    echo "Required Keychain item is empty for ${output_name}." >&2
    return 78
  }
  printf '%s' "${secret_value}" > "${secret_dir}/${output_name}"
  chmod 600 "${secret_dir}/${output_name}"
  unset secret_value
}

write_optional_keychain_secret() {
  local output_name="$1"
  local keychain_ref="$2"
  local remainder service account secret_value
  case "${keychain_ref}" in
    keychain://*/*) ;;
    *)
      echo "Invalid optional Keychain reference for ${output_name}." >&2
      return 78
      ;;
  esac
  remainder="${keychain_ref#keychain://}"
  service="${remainder%%/*}"
  account="${remainder#*/}"
  if [[ ! "${service}" =~ ^[A-Za-z0-9._-]+$ ]] ||
    [[ ! "${account}" =~ ^[A-Za-z0-9._/-]+$ ]] ||
    [[ "${account}" == *".."* ]]; then
    echo "Unsafe optional Keychain reference for ${output_name}." >&2
    return 78
  fi
  if secret_value="$(
    /usr/bin/security find-generic-password \
      -s "${service}" \
      -a "${account}" \
      -w 2>/dev/null
  )" && [[ -n "${secret_value}" ]]; then
    printf '%s' "${secret_value}" > "${secret_dir}/${output_name}"
    chmod 600 "${secret_dir}/${output_name}"
  fi
  unset secret_value
}

write_keychain_secret \
  postgres_password \
  "keychain://com.esan.gbos.local-pilot/postgres-password"
write_keychain_secret \
  postgres_observer_password \
  "keychain://com.esan.gbos.local-pilot/postgres-observer-password"
write_keychain_secret \
  postgres_context_password \
  "keychain://com.esan.gbos.local-pilot/postgres-context-password"
write_keychain_secret \
  postgres_agent_password \
  "keychain://com.esan.gbos.local-pilot/postgres-agent-password"
write_keychain_secret \
  postgres_media_password \
  "keychain://com.esan.gbos.local-pilot/postgres-media-password"
write_keychain_secret \
  mariadb_root_password \
  "keychain://com.esan.gbos.local-pilot/mariadb-root-password"
write_keychain_secret \
  frappe_admin_password \
  "keychain://com.esan.gbos.local-pilot/frappe-admin-password"
write_optional_keychain_secret \
  frappe_demo_password \
  "keychain://com.esan.gbos.local-pilot/frappe-demo-password"
write_keychain_secret \
  agent_api_bearer \
  "keychain://com.esan.gbos.local-pilot/agent-api-bearer"
write_keychain_secret \
  context_api_bearer \
  "keychain://com.esan.gbos.local-pilot/context-api-bearer"
write_keychain_secret \
  context_client_bearer \
  "keychain://com.esan.gbos.local-pilot/context-api-bearer"
write_keychain_secret \
  cursor_hmac_key \
  "keychain://com.esan.gbos.local-pilot/cursor-hmac-key"
write_keychain_secret \
  tokenizer_hmac_key \
  "keychain://com.esan.gbos.local-pilot/tokenizer-hmac-key"
write_keychain_secret \
  mapping_vault_key \
  "keychain://com.esan.gbos.local-pilot/mapping-vault-aes-256-key"
write_keychain_secret \
  media_runtime_key \
  "keychain://com.esan.gbos.local-pilot/media-runtime-key"
write_keychain_secret \
  frappe_materializer_api_key \
  "keychain://com.esan.gbos.local-pilot/frappe-materializer-api-key"
write_keychain_secret \
  frappe_materializer_api_secret \
  "keychain://com.esan.gbos.local-pilot/frappe-materializer-api-secret"

while IFS=$'\t' read -r output_name keychain_ref; do
  [[ -n "${output_name}" && -n "${keychain_ref}" ]] || continue
  write_keychain_secret "${output_name}" "${keychain_ref}"
done < <(
  python3 - "${MANIFEST}" <<'PY'
import json
import sys

manifest = json.load(open(sys.argv[1], encoding="utf-8"))
channels = manifest["channels"]
for channel, output in (
    ("email", "email_credential"),
    ("wecom", "wecom_credential"),
    ("whatsapp", "whatsapp_credential"),
):
    item = channels[channel]
    if item["enabled"]:
        print(f"{output}\t{item['credential_ref']}")
if any(channels[channel]["enabled"] for channel in ("email", "wecom", "whatsapp")):
    print(
        "identity_hmac_key\t"
        "keychain://com.esan.gbos.local-pilot/identity-hmac-key"
    )
    print(
        "frappe_identity_resolver_api_key\t"
        "keychain://com.esan.gbos.local-pilot/frappe-identity-resolver-api-key"
    )
    print(
        "frappe_identity_resolver_api_secret\t"
        "keychain://com.esan.gbos.local-pilot/frappe-identity-resolver-api-secret"
    )
deepseek = manifest["deepseek"]
if deepseek["enabled"]:
    print(f"deepseek_api_key\t{deepseek['keychain_ref']}")
    print(
        "trusted_phrase_lexicon\t"
        "keychain://com.esan.gbos.local-pilot/trusted-phrase-lexicon"
    )
if channels["whatsapp"]["enabled"]:
    print(
        "cloudflared_tunnel\t"
        "keychain://com.esan.gbos.local-pilot/cloudflared-tunnel-json"
    )
PY
)

# Compose declares every optional secret. Empty 0600 sentinels keep config
# deterministic; profile-gated services never receive an undeclared credential.
for optional in \
  email_credential \
  wecom_credential \
  whatsapp_credential \
  deepseek_api_key \
  trusted_phrase_lexicon \
  cloudflared_tunnel \
  identity_hmac_key \
  frappe_identity_resolver_api_key \
  frappe_identity_resolver_api_secret \
  frappe_demo_password; do
  if [[ ! -f "${secret_dir}/${optional}" ]]; then
    : > "${secret_dir}/${optional}"
    chmod 600 "${secret_dir}/${optional}"
  fi
done

completed=true
trap - EXIT HUP INT TERM
printf '%s\n' "${secret_dir}"
