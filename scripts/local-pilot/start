#!/usr/bin/env bash
set -euo pipefail
umask 077

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/lib.sh"

MANIFEST="${DEFAULT_MANIFEST}"
CANARY_CONTROL=""
while (( $# > 0 )); do
  case "$1" in
    --manifest)
      [[ $# -ge 2 ]] || { echo "--manifest requires a path" >&2; exit 64; }
      MANIFEST="$2"
      shift
      ;;
    --canary-control)
      [[ $# -ge 2 ]] || { echo "--canary-control requires a path" >&2; exit 64; }
      CANARY_CONTROL="$2"
      shift
      ;;
    *)
      echo "Usage: scripts/local-pilot/start [--manifest PATH] [--canary-control PATH]" >&2
      exit 64
      ;;
  esac
  shift
done

GBOS_LOCAL_PILOT_MANIFEST="$(
  CDPATH='' cd -- "$(dirname -- "${MANIFEST}")" &&
    printf '%s/%s\n' "$PWD" "$(basename -- "${MANIFEST}")"
)"
export GBOS_LOCAL_PILOT_MANIFEST

if [[ -z "${CANARY_CONTROL}" ]]; then
  if python3 - "${MANIFEST}" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        manifest = json.load(handle)
    channels = manifest["channels"]
    email = channels["email"]
    deepseek = manifest["deepseek"]
    if not all(isinstance(value, dict) for value in (manifest, channels, email, deepseek)):
        raise ValueError
except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(78)

raise SystemExit(10 if email.get("enabled") is True or deepseek.get("enabled") is True else 0)
PY
  then
    :
  else
    manifest_gate_status=$?
    if [[ "${manifest_gate_status}" -eq 10 ]]; then
      echo "Enabled Email or DeepSeek requires a bound canary control file." >&2
    else
      echo "Manifest enablement could not be evaluated safely." >&2
    fi
    exit 78
  fi
fi

if [[ -e "${EMERGENCY_STOP_FILE}" ]]; then
  echo "Emergency-stop latch is active; explicit acknowledgement is required." >&2
  exit 78
fi

if [[ -n "${CANARY_CONTROL}" ]]; then
  running_services="$(compose ps --status running --services)"
  while IFS= read -r running_service; do
    case "${running_service}" in
      agent-worker|communication-draft-worker|connector-worker|email-poller|identity-resolution-worker|model-projection-worker)
        echo "A canary producer or model worker is already running; stop it before guarded startup." >&2
        exit 78
        ;;
    esac
  done <<< "${running_services}"
fi

"${SCRIPT_DIR}/preflight" \
  --repo-root "${REPO_ROOT}" \
  --manifest "${MANIFEST}" \
  --require-go

GBOS_SECRET_DIR="$("${SCRIPT_DIR}/prepare-secrets" --manifest "${MANIFEST}")"
export GBOS_SECRET_DIR
mkdir -p -- "${RUNTIME_DIR}"
chmod 700 "${RUNTIME_DIR}"
printf '%s\n' "${GBOS_SECRET_DIR}" > "${SECRET_DIR_RECORD}"
chmod 600 "${SECRET_DIR_RECORD}"

compose_mutated="false"
rollback() {
  local original_status=$?
  local containment_verified="true"
  trap - EXIT HUP INT TERM
  if [[ "${compose_mutated}" == "true" ]]; then
    if ! "${SCRIPT_DIR}/emergency-stop"; then
      containment_verified="false"
      echo "Startup failed after runtime mutation; emergency containment is unverified." >&2
    fi
  fi
  if [[ "${compose_mutated}" == "false" || "${containment_verified}" == "true" ]]; then
    cleanup_config_dir
    cleanup_secret_dir
  else
    echo "Runtime config and secret files were preserved for containment recovery." >&2
  fi
  return "${original_status}"
}
trap rollback EXIT HUP INT TERM

if [[ -n "${CANARY_CONTROL}" ]]; then
  "${SCRIPT_DIR}/canary-preflight" \
    --manifest "${MANIFEST}" \
    --run-control "${CANARY_CONTROL}" \
    --secret-dir "${GBOS_SECRET_DIR}" \
    --repo-root "${REPO_ROOT}"
  GBOS_CANARY_CONTROL="$(
    CDPATH='' cd -- "$(dirname -- "${CANARY_CONTROL}")" &&
      printf '%s/%s\n' "$PWD" "$(basename -- "${CANARY_CONTROL}")"
  )"
  export GBOS_CANARY_CONTROL
  printf '%s\n' "${GBOS_CANARY_CONTROL}" > "${RUNTIME_DIR}/canary-control-path"
  chmod 600 "${RUNTIME_DIR}/canary-control-path"
fi

config_tmp_root="${TMPDIR:-/tmp}"
config_tmp_root="${config_tmp_root%/}"
GBOS_CONFIG_DIR="$(mktemp -d "${config_tmp_root}/gbos-local-pilot-config.XXXXXX")"
export GBOS_CONFIG_DIR
printf '%s\n' "${GBOS_CONFIG_DIR}" > "${CONFIG_DIR_RECORD}"
chmod 600 "${CONFIG_DIR_RECORD}"
"${SCRIPT_DIR}/render-config" \
  --manifest "${MANIFEST}" \
  --output-dir "${GBOS_CONFIG_DIR}"

GBOS_CONNECTOR_KILL_SWITCH="true"
GBOS_IDENTITY_RESOLUTION_KILL_SWITCH="true"
GBOS_MODEL_KILL_SWITCH="true"
GBOS_MODEL_PROJECTION_KILL_SWITCH="true"
GBOS_COMMUNICATION_DRAFT_KILL_SWITCH="true"
GBOS_DEEPSEEK_EGRESS_ENABLED="false"
GBOS_MATERIALIZATION_KILL_SWITCH="false"
GBOS_EXTERNAL_SEND_ENABLED="false"
export \
  GBOS_CONNECTOR_KILL_SWITCH \
  GBOS_IDENTITY_RESOLUTION_KILL_SWITCH \
  GBOS_MODEL_KILL_SWITCH \
  GBOS_MODEL_PROJECTION_KILL_SWITCH \
  GBOS_COMMUNICATION_DRAFT_KILL_SWITCH \
  GBOS_DEEPSEEK_EGRESS_ENABLED \
  GBOS_MATERIALIZATION_KILL_SWITCH \
  GBOS_EXTERNAL_SEND_ENABLED

profile_args=(--profile runtime --profile observability)
connector_profile_enabled=false
identity_profile_enabled=false
model_profile_requested=false
while IFS= read -r capability; do
  case "${capability}" in
    email|wecom|whatsapp)
      profile_args+=(--profile "${capability}")
      if [[ "${connector_profile_enabled}" == "false" ]]; then
        profile_args+=(--profile connectors)
      fi
      if [[ "${identity_profile_enabled}" == "false" ]]; then
        profile_args+=(--profile identity)
      fi
      connector_profile_enabled=true
      identity_profile_enabled=true
      ;;
    media)
      profile_args+=(--profile media)
      ;;
    model)
      model_profile_requested=true
      ;;
    tunnel:*)
      GBOS_CLOUDFLARED_TUNNEL_ID="${capability#tunnel:}"
      export GBOS_CLOUDFLARED_TUNNEL_ID
      profile_args+=(--profile tunnel)
      ;;
  esac
done < <(
  python3 - "${MANIFEST}" <<'PY'
import json
import sys

manifest = json.load(open(sys.argv[1], encoding="utf-8"))
channels = manifest["channels"]
for channel in ("email", "wecom", "whatsapp", "media"):
    if channels[channel]["enabled"]:
        print(channel)
if manifest["deepseek"]["enabled"]:
    print("model")
if channels["whatsapp"]["enabled"]:
    print("tunnel:" + channels["whatsapp"]["named_tunnel_ref"].removeprefix(
        "cloudflare://tunnel/"
    ))
PY
)

if [[ "${connector_profile_enabled}" == "true" ]]; then
  GBOS_CONNECTOR_KILL_SWITCH="false"
fi
if [[ "${identity_profile_enabled}" == "true" ]]; then
  GBOS_IDENTITY_RESOLUTION_KILL_SWITCH="false"
fi
export \
  GBOS_CONNECTOR_KILL_SWITCH \
  GBOS_IDENTITY_RESOLUTION_KILL_SWITCH \
  GBOS_MODEL_KILL_SWITCH \
  GBOS_MODEL_PROJECTION_KILL_SWITCH \
  GBOS_COMMUNICATION_DRAFT_KILL_SWITCH \
  GBOS_DEEPSEEK_EGRESS_ENABLED

compose "${profile_args[@]}" config --quiet
compose_mutated="true"
compose --profile runtime run --rm --no-deps runtime-volume-init
compose --profile runtime up -d --wait \
  postgres \
  mariadb \
  redis-cache \
  redis-queue \
  frappe-configurator \
  frappe-site \
  frappe-backend \
  frappe-websocket
compose --profile runtime run --rm migrations
if [[ "${model_profile_requested}" == "true" ]]; then
  compose --profile runtime --profile canary-start-guard \
    run --rm --no-deps canary-start-guard
  GBOS_MODEL_KILL_SWITCH="false"
  GBOS_MODEL_PROJECTION_KILL_SWITCH="false"
  GBOS_COMMUNICATION_DRAFT_KILL_SWITCH="false"
  GBOS_DEEPSEEK_EGRESS_ENABLED="true"
  profile_args+=(--profile model-projection)
  export \
    GBOS_MODEL_KILL_SWITCH \
    GBOS_MODEL_PROJECTION_KILL_SWITCH \
    GBOS_COMMUNICATION_DRAFT_KILL_SWITCH \
    GBOS_DEEPSEEK_EGRESS_ENABLED
fi
"${SCRIPT_DIR}/run-retention" --dry-run --manifest "${MANIFEST}"
compose --profile runtime --profile materializer-bootstrap run --rm --no-deps frappe-materializer-bootstrap
if [[ "${identity_profile_enabled}" == "true" ]]; then
  compose --profile runtime --profile identity-bootstrap run --rm --no-deps frappe-identity-resolver-bootstrap
fi
compose "${profile_args[@]}" up -d --wait

trap - EXIT HUP INT TERM
echo "Local pilot is running with only manifest-enabled profiles."
