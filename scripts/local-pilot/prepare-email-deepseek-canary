#!/usr/bin/env python3
"""Prepare a private repository-external Email + DeepSeek shadow-pilot declaration."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional

_SITE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.-]{0,139}$")
_KEYCHAIN = re.compile(r"^keychain://[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9._/-]+$")


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--acknowledge-shadow-pilot", action="store_true")
    parser.add_argument("--output-dir", required=True, type=Path)
    parser.add_argument("--site-id", required=True)
    parser.add_argument("--activation-time", required=True)
    parser.add_argument("--email-credential-ref", required=True)
    parser.add_argument("--deepseek-keychain-ref", required=True)
    return parser


def _private_json(path: Path, payload: Dict[str, Any]) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        temporary.chmod(stat.S_IRUSR | stat.S_IWUSR)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def _outside_repo(output: Path, repo_root: Path) -> Path:
    resolved = output.resolve()
    common = os.path.commonpath((str(resolved), str(repo_root.resolve())))
    if common == str(repo_root.resolve()):
        raise ValueError("canary output must be outside the repository")
    if resolved.exists():
        if resolved.is_symlink() or not resolved.is_dir() or any(resolved.iterdir()):
            raise ValueError("canary output must be a new or empty real directory")
    else:
        resolved.mkdir(mode=0o700, parents=True)
    resolved.chmod(0o700)
    return resolved


def _activation(value: str) -> str:
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise ValueError("activation time must be RFC3339") from exc
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        raise ValueError("activation time must include a timezone")
    return parsed.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")


def _source_commit(repo_root: Path) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=repo_root,
        check=False,
        capture_output=True,
        text=True,
    )
    value = result.stdout.strip()
    if result.returncode != 0 or re.fullmatch(r"[0-9a-f]{40}", value) is None:
        raise ValueError("repository source commit is unavailable")
    return value


def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main(argv: Optional[List[str]] = None) -> int:
    args = _parser().parse_args(argv)
    repo_root = Path(__file__).resolve().parents[2]
    try:
        if not args.acknowledge_shadow_pilot:
            raise ValueError("explicit shadow-pilot acknowledgement is required")
        if _SITE.fullmatch(args.site_id) is None:
            raise ValueError("site id is invalid")
        for value in (args.email_credential_ref, args.deepseek_keychain_ref):
            if _KEYCHAIN.fullmatch(value) is None or ".." in value:
                raise ValueError("Keychain reference is invalid")
        activation = _activation(args.activation_time)
        output = _outside_repo(args.output_dir, repo_root)
        template_path = repo_root / "infra" / "local" / "local-pilot-manifest.json"
        template = json.loads(template_path.read_text(encoding="utf-8"))
        if not isinstance(template, dict):
            raise ValueError("formal manifest template is invalid")
        manifest = dict(template)
        manifest["site_id"] = args.site_id
        manifest["local_pilot_go"] = True
        manifest["local_pilot_status"] = "ready"
        manifest["deepseek"] = {
            **template["deepseek"],
            "enabled": True,
            "keychain_ref": args.deepseek_keychain_ref,
            "kill_switch": False,
        }
        channels = {name: dict(value) for name, value in template["channels"].items()}
        channels["email"].update(
            {
                "enabled": True,
                "activation_time": activation,
                "backfill_history": False,
                "credential_ref": args.email_credential_ref,
            }
        )
        manifest["channels"] = channels
        manifest_path = output / "pilot-manifest.json"
        _private_json(manifest_path, manifest)
        control = {
            "schema_version": "1.1",
            "run_id": str(uuid.uuid4()),
            "state": "prepared",
            "created_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            "source_commit": _source_commit(repo_root),
            "manifest_sha256": _sha256(manifest_path),
            "activation_time": activation,
            "retention_days": 30,
            "stability_assessment": {
                "continuous_runtime_required": False,
                "seventy_two_hour_run": "deferred_by_user",
            },
            "scope": {
                "channels": ["email"],
                "model": "deepseek-v4-flash",
                "external_send": False,
                "formal_commands": False,
            },
            "required_inputs": [
                "email_credential_keychain_item",
                "deepseek_credential_keychain_item",
                "identity_hmac_keychain_item",
                "tokenizer_hmac_keychain_item",
                "mapping_vault_keychain_item",
                "trusted_phrase_lexicon_keychain_item",
                "frappe_materializer_identity",
                "frappe_identity_resolver_identity",
                "reviewer_user",
                "target_user_and_party",
            ],
            "live_checks": {
                "email_checkpoint_initialized": "pending",
                "empty_model_backlog": "pending",
                "observed_model_identity": "pending",
                "user_review": "pending",
                "party_review": "pending",
            },
        }
        _private_json(output / "canary-run.json", control)
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as exc:
        print(f"CANARY PREPARE FAILED: {exc}", file=sys.stderr)
        return 78
    print(f"Prepared private canary controls in {output}.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
