#!/usr/bin/env python3
"""Launch canary-chain verification with the repository-bound Python runtime."""

import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
PYTHON = ROOT / ".venv" / "bin" / "python"
PROGRAM = Path(__file__).with_suffix(".py")


def main():
    if not PYTHON.is_file() or not os.access(PYTHON, os.X_OK):
        print("CANARY ERROR: repository Python 3.14 is unavailable", file=sys.stderr)
        return 78
    probe = subprocess.run(
        [str(PYTHON), "-c", "import sys; raise SystemExit(sys.version_info < (3, 14))"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if probe.returncode != 0:
        print("CANARY ERROR: repository Python 3.14 is unavailable", file=sys.stderr)
        return 78
    os.execv(str(PYTHON), [str(PYTHON), str(PROGRAM), *sys.argv[1:]])
    return 78


if __name__ == "__main__":
    raise SystemExit(main())
