#!/usr/bin/env bash
set -euo pipefail
umask 077

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/lib.sh"

python3 "${SCRIPT_DIR}/containment.py" activate --runtime-dir "${RUNTIME_DIR}"
read_secret_dir
read_config_dir

# Preserve databases, the evidence CAS, monitoring, and the local UI for forensics.
targets=(
  cloudflared
  email-poller
  wecom-poller
  connector-worker
  identity-resolution-worker
  model-projection-worker
  communication-draft-worker
  email-command-publication-worker
  email-send-worker
  mailbox-config-projection-worker
  observer-email-publication-worker
  email-initial-route-worker
  email-gateway-retention-worker
  observer-email-material-retention-worker
  media-worker
  agent-worker
  materialization-worker
  retention-worker
  retention-scheduler
  webhook-ingress
  frappe-worker
  frappe-scheduler
)
stop_returncode=0
docker compose \
  --project-name "${PROJECT_NAME}" \
  -f "${COMPOSE_FILE}" \
  --profile "*" \
  stop "${targets[@]}" || stop_returncode=$?

running_file="$(mktemp "${RUNTIME_DIR}/running-services.XXXXXX")"
chmod 600 "${running_file}"
trap 'rm -f -- "${running_file}"' EXIT HUP INT TERM
ps_returncode=0
docker compose \
  --project-name "${PROJECT_NAME}" \
  -f "${COMPOSE_FILE}" \
  --profile "*" \
  ps --status running --services "${targets[@]}" > "${running_file}" || ps_returncode=$?

if ! python3 "${SCRIPT_DIR}/containment.py" record \
  --runtime-dir "${RUNTIME_DIR}" \
  --stop-returncode "${stop_returncode}" \
  --ps-returncode "${ps_returncode}" \
  --running-file "${running_file}"; then
  echo "Emergency stop latched, but containment could not be verified." >&2
  exit 1
fi

echo "Emergency stop latched and containment verified."
