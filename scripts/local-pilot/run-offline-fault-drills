#!/usr/bin/env python3
"""Run credential-free Task 13 fault drills and emit a content-free receipt."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Sequence, Tuple

_DRILLS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (
    (
        "email_duplicate_uid",
        (
            "tests/observer/test_email_imap.py::test_duplicate_search_uids_and_uid_gaps_preserve_uid_identity",
        ),
    ),
    (
        "email_uidvalidity_change",
        (
            "tests/observer/test_email_imap.py::test_uidvalidity_change_pauses_with_bounded_rescan_plan_and_keeps_checkpoint",
        ),
    ),
    (
        "email_attachment_quarantine",
        (
            "tests/observer/test_email_imap.py::test_attachment_limit_quarantines_candidates_but_preserves_raw_delivery",
            "tests/observer/test_email_imap.py::test_oversized_attachment_quarantines_candidates_but_preserves_raw_delivery",
        ),
    ),
    (
        "model_retry_and_protocol_failure",
        (
            "tests/model_gateway/test_deepseek.py::test_retryable_failures_retry_at_most_twice",
            "tests/model_gateway/test_deepseek.py::test_protocol_violations_fail_closed_without_retry",
        ),
    ),
    (
        "identity_restart_and_revocation",
        (
            "tests/integration/test_identity_resolution_offline_e2e.py::test_email_identity_resolution_offline_e2e",
        ),
    ),
)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--acknowledge-offline-drills", action="store_true")
    parser.add_argument("--output-dir", required=True, type=Path)
    parser.add_argument("--repo-root", required=True, type=Path)
    return parser


def _outside_repo(output: Path, repo_root: Path) -> Path:
    resolved = output.resolve()
    if os.path.commonpath((str(resolved), str(repo_root.resolve()))) == str(
        repo_root.resolve()
    ):
        raise ValueError("drill output must be outside the repository")
    if resolved.exists():
        if resolved.is_symlink() or not resolved.is_dir() or any(resolved.iterdir()):
            raise ValueError("drill output must be a new or empty real directory")
    else:
        resolved.mkdir(mode=0o700, parents=True)
    resolved.chmod(0o700)
    return resolved


def _atomic_private(path: Path, content: bytes) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        temporary.chmod(stat.S_IRUSR | stat.S_IWUSR)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def _source_commit(repo_root: Path) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=repo_root,
        check=False,
        capture_output=True,
        text=True,
    )
    value = result.stdout.strip()
    if result.returncode != 0 or re.fullmatch(r"[0-9a-f]{40}", value) is None:
        raise ValueError("source commit is unavailable")
    return value


def _run_drill(
    *, python: Path, repo_root: Path, drill: str, nodes: Sequence[str]
) -> Dict[str, Any]:
    started = time.monotonic()
    environment = os.environ.copy()
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    result = subprocess.run(
        [
            str(python),
            "-m",
            "pytest",
            "-q",
            "-p",
            "no:cacheprovider",
            "--disable-warnings",
            *nodes,
        ],
        cwd=repo_root,
        check=False,
        capture_output=True,
        text=False,
        env=environment,
    )
    return {
        "drill": drill,
        "passed": result.returncode == 0,
        "returncode": result.returncode,
        "duration_ms": max(0, int((time.monotonic() - started) * 1000)),
        "test_count": len(nodes),
        "error_code": None if result.returncode == 0 else "offline_drill_failed",
    }


def main(argv: Optional[List[str]] = None) -> int:
    args = _parser().parse_args(argv)
    try:
        if not args.acknowledge_offline_drills:
            raise ValueError("explicit offline-drill acknowledgement is required")
        repo_root = args.repo_root.resolve()
        python = repo_root / ".venv" / "bin" / "python"
        resolved_python = python.resolve(strict=True)
        if not resolved_python.is_file() or not os.access(resolved_python, os.X_OK):
            raise ValueError("frozen workspace Python is unavailable")
        output = _outside_repo(args.output_dir, repo_root)
        drills = [
            _run_drill(
                python=python,
                repo_root=repo_root,
                drill=drill,
                nodes=nodes,
            )
            for drill, nodes in _DRILLS
        ]
        passed = all(item["passed"] is True for item in drills)
        receipt = {
            "schema_version": "1.0",
            "captured_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            "source_commit": _source_commit(repo_root),
            "kind": "credential_free_offline_fault_drills",
            "drills": drills,
            "verdict": "pass" if passed else "fail",
            "live_provider_drills": "not_run",
        }
        serialized = (json.dumps(receipt, indent=2, sort_keys=True) + "\n").encode()
        receipt_path = output / "offline-fault-drills.json"
        _atomic_private(receipt_path, serialized)
        digest = hashlib.sha256(serialized).hexdigest()
        _atomic_private(output / "SHA256SUMS", f"{digest}  {receipt_path.name}\n".encode())
    except (OSError, ValueError) as exc:
        print(f"OFFLINE DRILLS FAILED: {exc}", file=sys.stderr)
        return 78
    print(f"Offline fault drills: {'pass' if passed else 'fail'}.")
    return 0 if passed else 1


if __name__ == "__main__":
    raise SystemExit(main())
