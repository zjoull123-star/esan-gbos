#!/usr/bin/env bash
set -euo pipefail

deploy_script_dir="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
deploy_repo_root="$(CDPATH='' cd -- "${deploy_script_dir}/../.." && pwd -P)"
deploy_python="${deploy_repo_root}/.venv/bin/python"

if [[ ! -x "${deploy_python}" ]]; then
  echo "DEPLOYMENT_SECRET_PREFLIGHT_RUNTIME_UNAVAILABLE" >&2
  exit 78
fi

cd -- "${deploy_repo_root}"
exec "${deploy_repo_root}/.venv/bin/python" \
  -m services.local_pilot_runtime.deployment_secret_preflight "$@"
