{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/v1/extracted-fact.schema.json",
  "title": "ExtractedFact",
  "description": "A typed, evidence-backed proposition produced by an extraction model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fact_id",
    "subject_ref",
    "predicate",
    "value",
    "confidence",
    "evidence_refs",
    "model",
    "status",
    "extracted_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "fact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "predicate": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,79}$"
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "boolean",
            "date",
            "datetime",
            "reference"
          ]
        },
        "text": {
          "type": "string"
        },
        "number": {
          "type": "number"
        },
        "boolean": {
          "type": "boolean"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "datetime": {
          "type": "string",
          "format": "date-time"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "maxLength": 80
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "required": [
              "number"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "required": [
              "boolean"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "date"
              }
            }
          },
          "then": {
            "required": [
              "date"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "datetime"
              }
            }
          },
          "then": {
            "required": [
              "datetime"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reference"
              }
            }
          },
          "then": {
            "required": [
              "reference"
            ]
          }
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "prompt_version"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "confirmed",
        "rejected"
      ]
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
