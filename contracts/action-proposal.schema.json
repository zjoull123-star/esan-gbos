{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/gate2/action-proposal.schema.json",
  "title": "ActionProposal",
  "description": "A policy-scoped proposal for a reversible internal GBOS action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_proposal_id",
    "site_id",
    "processing_purpose",
    "action_type",
    "status",
    "decision_ref",
    "evidence_refs",
    "requested_by",
    "payload_digest",
    "policy_version",
    "created_at",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "action_proposal_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "site_id": {
      "$ref": "common.schema.json#/$defs/SiteId"
    },
    "processing_purpose": {
      "$ref": "common.schema.json#/$defs/ProcessingPurpose"
    },
    "action_type": {
      "$ref": "common.schema.json#/$defs/ActionType"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "awaiting_approval"
      ]
    },
    "decision_ref": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "evidence_refs": {
      "$ref": "common.schema.json#/$defs/EvidenceRefs"
    },
    "requested_by": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version": {
      "$ref": "common.schema.json#/$defs/Version"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    }
  }
}
