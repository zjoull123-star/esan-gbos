  "components": {
    "securitySchemes": {
      "FrappeSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid"
      },
      "FrappeCsrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Frappe-CSRF-Token"
      }
    },
    "schemas": {
      "Mailbox": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mailbox_ref",
          "display_label",
          "provider_kind",
          "business_mode",
          "business_purpose",
          "default_team_label",
          "account_owner_label",
          "inbound_enabled",
          "outbound_enabled",
          "status",
          "config_revision"
        ],
        "properties": {
          "mailbox_ref": {
            "type": "string",
            "maxLength": 140
          },
          "display_label": {
            "type": "string",
            "maxLength": 240
          },
          "provider_kind": {
            "type": "string",
            "enum": [
              "fake",
              "imap_smtp",
              "wecom_app_mail"
            ]
          },
          "business_mode": {
            "type": "string",
            "enum": [
              "primary",
              "selective_archive",
              "migration"
            ]
          },
          "business_purpose": {
            "type": "string",
            "maxLength": 80
          },
          "default_team_label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          },
          "account_owner_label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          },
          "inbound_enabled": {
            "type": "boolean"
          },
          "outbound_enabled": {
            "type": "boolean",
            "const": false
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "paused",
              "revoked",
              "error"
            ]
          },
          "config_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "InboxItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inbox_item_ref",
          "mailbox_label",
          "mailbox_role",
          "received_at",
          "state",
          "safe_summary",
          "team_label",
          "revision"
        ],
        "properties": {
          "inbox_item_ref": {
            "type": "string",
            "maxLength": 140
          },
          "mailbox_label": {
            "type": "string",
            "maxLength": 240
          },
          "mailbox_role": {
            "type": "string",
            "enum": [
              "primary",
              "selective_archive",
              "migration"
            ]
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string",
            "enum": [
              "identity_pending",
              "unassigned",
              "assigned",
              "draft",
              "waiting_internal",
              "waiting_customer",
              "converted",
              "closed",
              "quarantined",
              "send_queued",
              "send_uncertain"
            ]
          },
          "safe_summary": {
            "type": "string",
            "maxLength": 500
          },
          "team_label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "InboxDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inbox_item_ref",
          "mailbox_label",
          "mailbox_role",
          "received_at",
          "state",
          "safe_summary",
          "team_label",
          "revision",
          "assignee_label",
          "identity_state"
        ],
        "properties": {
          "inbox_item_ref": {
            "type": "string"
          },
          "mailbox_label": {
            "type": "string"
          },
          "mailbox_role": {
            "type": "string"
          },
          "received_at": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "identity_pending",
              "unassigned",
              "assigned",
              "draft",
              "waiting_internal",
              "waiting_customer",
              "converted",
              "closed",
              "quarantined",
              "send_queued",
              "send_uncertain"
            ]
          },
          "safe_summary": {
            "type": "string"
          },
          "team_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": "integer"
          },
          "assignee_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "identity_state": {
            "type": "string",
            "enum": [
              "unknown",
              "confirmed",
              "revoked"
            ]
          }
        }
      },
      "ConnectorHealth": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mailbox_ref",
          "mailbox_label",
          "status",
          "freshness",
          "backlog",
          "last_success_at",
          "safe_error_code"
        ],
        "properties": {
          "mailbox_ref": {
            "type": "string"
          },
          "mailbox_label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded",
              "paused",
              "revoked",
              "unknown"
            ]
          },
          "freshness": {
            "type": "string",
            "enum": [
              "fresh",
              "stale",
              "unknown"
            ]
          },
          "backlog": {
            "type": "integer",
            "minimum": 0
          },
          "last_success_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "safe_error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MailboxUpsertCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_label",
          "provider_kind",
          "business_mode",
          "business_purpose",
          "canonical_mailbox_address",
          "provider_account_ref",
          "observer_connector_instance_ref",
          "default_team_ref",
          "account_owner_user_ref",
          "priority",
          "credential_ref",
          "inbound_enabled",
          "outbound_enabled",
          "expected_revision",
          "idempotency_key"
        ],
        "properties": {
          "mailbox_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "display_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "provider_kind": {
            "type": "string",
            "enum": [
              "fake",
              "imap_smtp",
              "wecom_app_mail"
