          },
          "business_mode": {
            "type": "string",
            "enum": [
              "primary",
              "selective_archive",
              "migration"
            ]
          },
          "business_purpose": {
            "type": "string",
            "enum": [
              "business_operations",
              "observation_processing",
              "entity_resolution",
              "customer_service",
              "sales_follow_up",
              "procurement_coordination",
              "product_sample_management",
              "risk_review",
              "metric_reporting",
              "audit_compliance"
            ]
          },
          "canonical_mailbox_address": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "writeOnly": true
          },
          "provider_account_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "observer_connector_instance_ref": {
            "type": "string",
