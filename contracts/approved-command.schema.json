{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/v1/approved-command.schema.json",
  "title": "ApprovedCommand",
  "description": "A human-authorized, idempotent command for an internal formal state change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "site_id",
    "command_type",
    "actor",
    "review_case",
    "target_doctype",
    "target_name",
    "expected_revision",
    "payload_sha256",
    "idempotency_key",
    "before_status",
    "after_status",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "command_type": {
      "type": "string",
      "pattern": "^(?!kingdee\\.)[a-z][a-z0-9_]+\\.[a-z][a-z0-9_]+$"
    },
    "actor": {
      "type": "string",
      "minLength": 3,
      "maxLength": 320
    },
    "review_case": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target_doctype": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "target_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "before_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "after_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
