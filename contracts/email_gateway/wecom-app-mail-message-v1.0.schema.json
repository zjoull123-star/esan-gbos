{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbos.invalid/contracts/email_gateway/wecom-app-mail-message-v1.0.schema.json",
  "title": "WeCom application read-mail success response v1.0",
  "description": "Closed successful JSON response from read_mail with bounded RFC822/EML content. The 1024-character ceiling is a GBOS v1 fixture/parser safety bound, not a claimed provider limit.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "errcode": {
      "type": "integer",
      "const": 0
    },
    "errmsg": {
      "type": "string",
      "const": "ok",
      "maxLength": 2
    },
    "mail_data": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?=[\\s\\S]*\\r\\nFrom:)(?=[\\s\\S]*\\r\\nTo:)(?=[\\s\\S]*\\r\\nSubject:)(?=[\\s\\S]*\\r\\n\\r\\n)[^\\u0000]+$"
    }
  },
  "required": ["errcode", "errmsg", "mail_data"]
}
