{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/email-gateway/v1.0/email-message-publication.schema.json",
  "title": "EmailMessagePublication v1.0",
  "description": "Content-minimized, provider-neutral Observer publication for one accepted email delivery. It contains no raw address, provider identifier, header value, body, attachment, EML, cursor, or secret.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publication_id",
    "site_id",
    "mailbox_id",
    "mailbox_config_revision",
    "observer_connector_instance_ref",
    "observer_delivery_ref",
    "received_at",
    "participants",
    "header_digests",
    "evidence_refs",
    "publication_revision",
    "idempotency_key"
  ],
  "properties": {
    "publication_id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^PUB-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
    },
    "mailbox_id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^MBX-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "mailbox_config_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "observer_connector_instance_ref": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^OCI-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "observer_delivery_ref": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^DLV-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "received_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 35,
      "format": "date-time"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address_role",
          "identity_ref"
        ],
        "properties": {
          "address_role": {
            "type": "string",
            "minLength": 2,
            "maxLength": 4,
            "enum": [
              "from",
              "to",
              "cc",
              "bcc"
            ]
          },
          "identity_ref": {
            "type": "string",
            "minLength": 46,
            "maxLength": 58,
            "pattern": "^(?:extid:v1:email:[A-Za-z0-9_-]{43}|unresolved:delivery:[0-9A-HJKMNP-TV-Z]{26})$"
          }
        }
      }
    },
    "subject_projection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
    },
    "subject_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "header_digests": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "in_reply_to": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 30,
        "maxLength": 30,
        "pattern": "^EVR-[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "publication_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 72,
      "maxLength": 72,
      "pattern": "^idem:v1:[a-f0-9]{64}$"
    }
  },
  "oneOf": [
    {
      "required": [
        "subject_projection"
      ],
      "not": {
        "required": [
          "subject_digest"
        ]
      }
    },
    {
      "required": [
        "subject_digest"
      ],
      "not": {
        "required": [
          "subject_projection"
        ]
      }
    }
  ]
}
