{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/local-pilot/v1.0/model-invocation.schema.json",
  "title": "ModelInvocation v1.0",
  "description": "Content-free audit metadata for one provider-neutral model invocation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_id",
    "site_id",
    "provider",
    "requested_model",
    "observed_model",
    "prompt_version",
    "output_schema_version",
    "policy_version",
    "tokenizer_version",
    "request_id",
    "response_id",
    "started_at",
    "completed_at",
    "latency_ms",
    "status",
    "token_usage",
    "cost",
    "network_call_count",
    "tool_call_count",
    "external_send_count",
    "references"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "requested_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "observed_model": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 160
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "output_schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "tokenizer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "response_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "timed_out",
        "cancelled"
      ]
    },
    "token_usage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unknown"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "input_tokens",
            "output_tokens",
            "total_tokens"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "cost": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unknown"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "amount",
            "currency"
          ],
          "properties": {
            "status": {
              "const": "known"
            },
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      ]
    },
    "network_call_count": {
      "type": "integer",
      "minimum": 0
    },
    "tool_call_count": {
      "type": "integer",
      "minimum": 0
    },
    "external_send_count": {
      "type": "integer",
      "minimum": 0
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_event_refs",
        "evidence_refs",
        "tokenization_receipt_refs"
      ],
      "properties": {
        "observation_event_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "tokenization_receipt_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
