{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/local-pilot/v1.0/upload-receipt.schema.json",
  "title": "UploadReceipt v1.0",
  "description": "Content-free receipt for one authenticated, streamed local-pilot upload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "site_id",
    "purpose",
    "request_id",
    "source_kind",
    "media_type",
    "byte_size",
    "sha256",
    "object_ref",
    "evidence_ref",
    "received_at",
    "retention_days",
    "consent_basis",
    "immutable_checksum"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "phone",
        "meeting",
        "file"
      ]
    },
    "media_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "object_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:object|localobject)://[A-Za-z0-9][A-Za-z0-9._~:/-]*$"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^evidence://[A-Za-z0-9][A-Za-z0-9._~:/-]*$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "retention_days": {
      "const": 30
    },
    "consent_basis": {
      "const": "pilot_deferred_review"
    },
    "immutable_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
