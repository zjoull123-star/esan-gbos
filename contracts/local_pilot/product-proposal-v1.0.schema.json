{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/local-pilot/v1.0/product-proposal.schema.json",
  "title": "ProductProposalOutput v1.0",
  "description": "Closed, internal-only product work-item proposal output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "agent_kind",
    "action_type",
    "status",
    "subject_ref",
    "evidence_refs",
    "confidence",
    "requires_human_review",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "agent_kind": {
      "const": "product"
    },
    "action_type": {
      "const": "internal.work_item.propose"
    },
    "status": {
      "const": "proposed"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_human_review": {
      "const": true
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "suggested_work_item"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "suggested_work_item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
