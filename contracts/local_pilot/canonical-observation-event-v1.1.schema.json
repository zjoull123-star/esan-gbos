{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/local-pilot/v1.1/canonical-observation-event.schema.json",
  "title": "CanonicalObservationEvent v1.1",
  "description": "Additive local-pilot observation envelope. The frozen v1.0 contract remains unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "site_id",
    "connector",
    "connector_instance_id",
    "channel",
    "occurred_at",
    "ingested_at",
    "original_language",
    "participants",
    "evidence_refs",
    "consent_basis",
    "data_classification",
    "retention_class",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "connector": {
      "type": "string",
      "enum": [
        "email",
        "wecom",
        "whatsapp",
        "phone",
        "meeting",
        "file",
        "manual_import",
        "wechat_workphone"
      ]
    },
    "connector_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "chat",
        "call",
        "meeting",
        "document",
        "manual_import"
      ]
    },
    "provider_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "original_language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "identity_ref"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "internal",
              "external",
              "system",
              "unknown"
            ]
          },
          "identity_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "display_name": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "consent_basis": {
      "type": "string",
      "enum": [
        "consent",
        "contract",
        "legal_obligation",
        "legitimate_interest",
        "manual_import_pending_review",
        "pilot_deferred_review"
      ]
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "Public",
        "Internal",
        "Confidential",
        "Restricted"
      ]
    },
    "retention_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "anyOf": [
    {
      "required": [
        "provider_event_id"
      ]
    },
    {
      "required": [
        "raw_sha256"
      ]
    }
  ]
}
