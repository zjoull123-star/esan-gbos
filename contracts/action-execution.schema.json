{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/gate2/action-execution.schema.json",
  "title": "ActionExecution",
  "description": "Execution state for a human-approved internal command.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_execution_id",
    "site_id",
    "proposal_ref",
    "approval_ref",
    "approved_command_ref",
    "approval_status_snapshot",
    "action_type",
    "payload_digest",
    "status",
    "idempotency_key",
    "started_at",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "action_execution_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "site_id": {
      "$ref": "common.schema.json#/$defs/SiteId"
    },
    "proposal_ref": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "approval_ref": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "approved_command_ref": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "approval_status_snapshot": {
      "const": "approved"
    },
    "action_type": {
      "$ref": "common.schema.json#/$defs/ActionType"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "executing",
        "succeeded",
        "failed",
        "verification_required"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "completed_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "output_artifact_ref": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "failure_classification": {
      "type": "string",
      "enum": [
        "policy",
        "conflict",
        "dependency",
        "unknown_result",
        "internal"
      ]
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "verification_required"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completed_at"
        ]
      }
    }
  ]
}
