{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbos.esan.dev/contracts/gate6/privacy-cross-border-approval.schema.json",
  "title": "GBOS Gate 6 cross-border entry gate manifest",
  "allOf": [
    {
      "$ref": "https://gbos.esan.dev/contracts/gate6/privacy-common.schema.json#/$defs/core"
    },
    {
      "$ref": "https://gbos.esan.dev/contracts/gate6/privacy-common.schema.json#/$defs/standardLifecycle"
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "executed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "fixture_mode": {
            "const": "externally_verified"
          },
          "external_readiness": {
            "properties": {
              "formal_privacy_legal": {
                "const": "verified_external_input"
              },
              "real_personal_data": {
                "const": "verified_external_input"
              },
              "singapore_cross_border": {
                "const": "verified_external_input"
              }
            }
          },
          "cross_border": {
            "properties": {
              "legal_mechanism_assessment": {
                "properties": {
                  "conclusion_status": {
                    "const": "externally_approved"
                  }
                }
              },
              "expiry_status": {
                "const": "current"
              },
              "notice_or_applicable_basis": {
                "properties": {
                  "basis_type": {
                    "enum": [
                      "consent",
                      "contract",
                      "legal_obligation",
                      "legitimate_interest"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "cross_border"
  ],
  "properties": {
    "operation": {
      "const": "cross_border_approval"
    },
    "cross_border": {
      "type": "object",
      "required": [
        "purpose",
        "data_categories",
        "recipient_processor",
        "destination_jurisdiction",
        "legal_mechanism_assessment",
        "notice_or_applicable_basis",
        "retention",
        "security_controls",
        "approvers",
        "expires_at",
        "review_at",
        "expiry_status",
        "local_fixture_is_legal_approval"
      ],
      "properties": {
        "purpose": {
          "$ref": "https://gbos.esan.dev/contracts/gate6/privacy-common.schema.json#/$defs/safeText"
        },
        "data_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "business_contact_pseudonymous",
              "transaction_metadata_synthetic",
              "support_metadata_synthetic",
              "audit_metadata_synthetic"
            ]
          }
        },
        "recipient_processor": {
          "type": "object",
          "required": [
            "recipient_ref",
            "processor_role",
            "subprocessor_refs"
          ],
          "properties": {
            "recipient_ref": {
              "$ref": "https://gbos.esan.dev/contracts/gate6/privacy-common.schema.json#/$defs/reference"
            },
            "processor_role": {
              "enum": [
                "processor",
                "subprocessor"
              ]
            },
            "subprocessor_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "https://gbos.esan.dev/contracts/gate6/privacy-common.schema.json#/$defs/reference"
              }
            }
          },
          "additionalProperties": false
        },
        "destination_jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}(?:-[A-Z0-9]{1,3})?$"
        },
        "legal_mechanism_assessment": {
          "type": "object",
          "required": [
            "mechanism",
            "assessment_ref",
            "assessed_at",
            "conclusion_status"
          ],
          "properties": {
            "mechanism": {
              "enum": [
                "pending_external_determination",
                "contractual_transfer_mechanism",
                "other_externally_approved_mechanism"
              ]
            },
            "assessment_ref": {
              "$ref": "https://gbos.esan.dev/contracts/gate6/privacy-common.schema.json#/$defs/reference"
            },
            "assessed_at": {
              "type": "string",
              "format": "date-time"
            },
            "conclusion_status": {
              "enum": [
                "blocked_external_input",
                "externally_approved"
              ]
            }
          },
          "additionalProperties": false
        },
        "notice_or_applicable_basis": {
          "type": "object",
          "required": [
            "basis_type",
            "notice_ref",
            "basis_review_ref"
          ],
          "properties": {
            "basis_type": {
              "enum": [
                "consent",
                "contract",
                "legal_obligation",
                "legitimate_interest",
                "pending_external_determination"
              ]
            },
            "notice_ref": {
              "$ref": "https://gbos.esan.dev/contracts/gate6/privacy-common.schema.json#/$defs/reference"
            },
            "basis_review_ref": {
              "$ref": "https://gbos.esan.dev/contracts/gate6/privacy-common.schema.json#/$defs/reference"
            },
            "consent_ref": {
              "$ref": "https://gbos.esan.dev/contracts/gate6/privacy-common.schema.json#/$defs/reference"
            }
          },
          "additionalProperties": false
        },
        "retention": {
          "type": "object",
          "required": [
            "duration_days",
            "deletion_method",
            "review_at"
          ],
          "properties": {
            "duration_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            },
            "deletion_method": {
              "enum": [
                "cryptographic_erasure",
                "verified_delete",
                "anonymize"
              ]
            },
            "review_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "security_controls": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "encryption_in_transit",
              "encryption_at_rest",
              "tenant_isolation",
              "least_privilege",
              "access_audit",
              "key_separation",
              "incident_notification",
              "subprocessor_change_control"
            ]
          }
        },
        "approvers": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^approver:[a-z0-9][a-z0-9._:-]{2,127}$"
          },
          "allOf": [
            {
              "contains": {
                "type": "string",
                "pattern": "^approver:privacy-[a-z0-9][a-z0-9._:-]{1,119}$"
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "string",
                "pattern": "^approver:security-[a-z0-9][a-z0-9._:-]{1,118}$"
              },
              "minContains": 1
            }
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_at": {
          "type": "string",
          "format": "date-time"
        },
        "expiry_status": {
          "enum": [
            "current",
            "expired",
            "not_applicable_pending_external"
          ]
        },
        "local_fixture_is_legal_approval": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
