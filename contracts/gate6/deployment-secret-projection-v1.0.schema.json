{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbos.esan.invalid/contracts/gate6/deployment-secret-projection-v1.0.schema.json",
  "title": "GBOS value-free deployment secret projection v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site_id", "environment", "projections"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,139}$"
    },
    "environment": {
      "enum": ["development", "test", "preproduction", "production"]
    },
    "projections": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": { "$ref": "#/$defs/projection" },
      "allOf": [
        { "$ref": "#/$defs/exactlyOnePostgresPassword" },
        { "$ref": "#/$defs/exactlyOnePostgresObserverPassword" },
        { "$ref": "#/$defs/exactlyOnePostgresContextPassword" },
        { "$ref": "#/$defs/exactlyOnePostgresAgentPassword" },
        { "$ref": "#/$defs/exactlyOnePostgresMediaPassword" },
        { "$ref": "#/$defs/exactlyOneMariadbRootPassword" },
        { "$ref": "#/$defs/exactlyOneFrappeAdminPassword" },
        { "$ref": "#/$defs/exactlyOneFrappeDemoPassword" },
        { "$ref": "#/$defs/exactlyOneAgentApiBearer" },
        { "$ref": "#/$defs/exactlyOneContextApiBearer" },
        { "$ref": "#/$defs/exactlyOneContextClientBearer" },
        { "$ref": "#/$defs/exactlyOneCursorHmacKey" },
        { "$ref": "#/$defs/exactlyOneTokenizerHmacKey" },
        { "$ref": "#/$defs/exactlyOneMappingVaultKey" },
        { "$ref": "#/$defs/exactlyOneTrustedPhraseLexicon" },
        { "$ref": "#/$defs/exactlyOneMediaRuntimeKey" },
        { "$ref": "#/$defs/exactlyOneDeepseekApiKey" },
        { "$ref": "#/$defs/exactlyOneFrappeMaterializerApiKey" },
        { "$ref": "#/$defs/exactlyOneFrappeMaterializerApiSecret" },
        { "$ref": "#/$defs/exactlyOneIdentityHmacKey" },
        { "$ref": "#/$defs/exactlyOneFrappeIdentityResolverApiKey" },
        { "$ref": "#/$defs/exactlyOneFrappeIdentityResolverApiSecret" },
        { "$ref": "#/$defs/exactlyOneEmailCredential" },
        { "$ref": "#/$defs/exactlyOneWecomCredential" },
        { "$ref": "#/$defs/exactlyOneWhatsappCredential" },
        { "$ref": "#/$defs/exactlyOneCloudflaredTunnel" }
      ]
    }
  },
  "$defs": {
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_name",
        "target_filename",
        "kind",
        "minimum_bytes",
        "maximum_bytes",
        "component",
        "required",
        "platform_version_id"
      ],
      "properties": {
        "logical_name": { "type": "string" },
        "target_filename": { "type": "string" },
        "kind": { "enum": ["text", "bytes", "closed_json"] },
        "minimum_bytes": { "type": "integer", "minimum": 1 },
        "maximum_bytes": { "type": "integer", "minimum": 1 },
        "exact_bytes": { "type": "integer", "minimum": 1 },
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "required": { "type": "boolean" },
        "platform_version_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
        }
      },
      "oneOf": [
        { "$ref": "#/$defs/postgresPassword" },
        { "$ref": "#/$defs/postgresObserverPassword" },
        { "$ref": "#/$defs/postgresContextPassword" },
        { "$ref": "#/$defs/postgresAgentPassword" },
        { "$ref": "#/$defs/postgresMediaPassword" },
        { "$ref": "#/$defs/mariadbRootPassword" },
        { "$ref": "#/$defs/frappeAdminPassword" },
        { "$ref": "#/$defs/frappeDemoPassword" },
        { "$ref": "#/$defs/agentApiBearer" },
        { "$ref": "#/$defs/contextApiBearer" },
        { "$ref": "#/$defs/contextClientBearer" },
        { "$ref": "#/$defs/cursorHmacKey" },
        { "$ref": "#/$defs/tokenizerHmacKey" },
        { "$ref": "#/$defs/mappingVaultKey" },
        { "$ref": "#/$defs/trustedPhraseLexicon" },
        { "$ref": "#/$defs/mediaRuntimeKey" },
        { "$ref": "#/$defs/deepseekApiKey" },
        { "$ref": "#/$defs/frappeMaterializerApiKey" },
        { "$ref": "#/$defs/frappeMaterializerApiSecret" },
        { "$ref": "#/$defs/identityHmacKey" },
        { "$ref": "#/$defs/frappeIdentityResolverApiKey" },
        { "$ref": "#/$defs/frappeIdentityResolverApiSecret" },
        { "$ref": "#/$defs/emailCredential" },
        { "$ref": "#/$defs/wecomCredential" },
        { "$ref": "#/$defs/whatsappCredential" },
        { "$ref": "#/$defs/cloudflaredTunnel" }
      ]
    },
    "boundedText": {
      "properties": {
        "kind": { "const": "text" },
        "minimum_bytes": { "const": 1 },
        "maximum_bytes": { "const": 4096 }
      },
      "not": { "required": ["exact_bytes"] }
    },
    "cursorText": {
      "properties": {
        "kind": { "const": "text" },
        "minimum_bytes": { "const": 32 },
        "maximum_bytes": { "const": 4096 }
      },
      "not": { "required": ["exact_bytes"] }
    },
    "exact32Bytes": {
      "required": ["exact_bytes"],
      "properties": {
        "kind": { "const": "bytes" },
        "minimum_bytes": { "const": 32 },
        "maximum_bytes": { "const": 32 },
        "exact_bytes": { "const": 32 }
      }
    },
    "boundedClosedJson": {
      "properties": {
        "kind": { "const": "closed_json" },
        "minimum_bytes": { "const": 1 },
        "maximum_bytes": { "const": 65536 }
      },
      "not": { "required": ["exact_bytes"] }
    },
    "postgresPassword": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "postgres_password" }, "target_filename": { "const": "/run/secrets/postgres_password" } } }
      ]
    },
    "postgresObserverPassword": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "postgres_observer_password" }, "target_filename": { "const": "/run/secrets/postgres_observer_password" } } }
      ]
    },
    "postgresContextPassword": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "postgres_context_password" }, "target_filename": { "const": "/run/secrets/postgres_context_password" } } }
      ]
    },
    "postgresAgentPassword": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "postgres_agent_password" }, "target_filename": { "const": "/run/secrets/postgres_agent_password" } } }
      ]
    },
    "postgresMediaPassword": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "postgres_media_password" }, "target_filename": { "const": "/run/secrets/postgres_media_password" } } }
      ]
    },
    "mariadbRootPassword": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "mariadb_root_password" }, "target_filename": { "const": "/run/secrets/mariadb_root_password" } } }
      ]
    },
    "frappeAdminPassword": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "frappe_admin_password" }, "target_filename": { "const": "/run/secrets/frappe_admin_password" } } }
      ]
    },
    "frappeDemoPassword": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "frappe_demo_password" }, "target_filename": { "const": "/run/secrets/frappe_demo_password" } } }
      ]
    },
    "agentApiBearer": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "agent_api_bearer" }, "target_filename": { "const": "/run/secrets/agent_api_bearer" } } }
      ]
    },
    "contextApiBearer": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "context_api_bearer" }, "target_filename": { "const": "/run/secrets/context_api_bearer" } } }
      ]
    },
    "contextClientBearer": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "context_client_bearer" }, "target_filename": { "const": "/run/secrets/context_client_bearer" } } }
      ]
    },
    "cursorHmacKey": {
      "allOf": [
        { "$ref": "#/$defs/cursorText" },
        { "properties": { "logical_name": { "const": "cursor_hmac_key" }, "target_filename": { "const": "/run/secrets/cursor_hmac_key" } } }
      ]
    },
    "tokenizerHmacKey": {
      "allOf": [
        { "$ref": "#/$defs/exact32Bytes" },
        { "properties": { "logical_name": { "const": "tokenizer_hmac_key" }, "target_filename": { "const": "/run/secrets/tokenizer_hmac_key" } } }
      ]
    },
    "mappingVaultKey": {
      "allOf": [
        { "$ref": "#/$defs/exact32Bytes" },
        { "properties": { "logical_name": { "const": "mapping_vault_key" }, "target_filename": { "const": "/run/secrets/mapping_vault_key" } } }
      ]
    },
    "trustedPhraseLexicon": {
      "allOf": [
        { "$ref": "#/$defs/boundedClosedJson" },
        { "properties": { "logical_name": { "const": "trusted_phrase_lexicon" }, "target_filename": { "const": "/run/secrets/trusted_phrase_lexicon" } } }
      ]
    },
    "mediaRuntimeKey": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "media_runtime_key" }, "target_filename": { "const": "/run/secrets/media_runtime_key" } } }
      ]
    },
    "deepseekApiKey": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "deepseek_api_key" }, "target_filename": { "const": "/run/secrets/deepseek_api_key" } } }
      ]
    },
    "frappeMaterializerApiKey": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "frappe_materializer_api_key" }, "target_filename": { "const": "/run/secrets/frappe_materializer_api_key" } } }
      ]
    },
    "frappeMaterializerApiSecret": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "frappe_materializer_api_secret" }, "target_filename": { "const": "/run/secrets/frappe_materializer_api_secret" } } }
      ]
    },
    "identityHmacKey": {
      "allOf": [
        { "$ref": "#/$defs/exact32Bytes" },
        { "properties": { "logical_name": { "const": "identity_hmac_key" }, "target_filename": { "const": "/run/secrets/identity_hmac_key" } } }
      ]
    },
    "frappeIdentityResolverApiKey": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "frappe_identity_resolver_api_key" }, "target_filename": { "const": "/run/secrets/frappe_identity_resolver_api_key" } } }
      ]
    },
    "frappeIdentityResolverApiSecret": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "properties": { "logical_name": { "const": "frappe_identity_resolver_api_secret" }, "target_filename": { "const": "/run/secrets/frappe_identity_resolver_api_secret" } } }
      ]
    },
    "emailCredential": {
      "allOf": [
        { "$ref": "#/$defs/boundedClosedJson" },
        { "properties": { "logical_name": { "const": "email_credential" }, "target_filename": { "const": "/run/secrets/email_credential" } } }
      ]
    },
    "wecomCredential": {
      "allOf": [
        { "$ref": "#/$defs/boundedClosedJson" },
        { "properties": { "logical_name": { "const": "wecom_credential" }, "target_filename": { "const": "/run/secrets/wecom_credential" } } }
      ]
    },
    "whatsappCredential": {
      "allOf": [
        { "$ref": "#/$defs/boundedClosedJson" },
        { "properties": { "logical_name": { "const": "whatsapp_credential" }, "target_filename": { "const": "/run/secrets/whatsapp_credential" } } }
      ]
    },
    "cloudflaredTunnel": {
      "allOf": [
        { "$ref": "#/$defs/boundedClosedJson" },
        { "properties": { "logical_name": { "const": "cloudflared_tunnel" }, "target_filename": { "const": "/run/secrets/cloudflared_tunnel" } } }
      ]
    },
    "exactlyOnePostgresPassword": { "contains": { "$ref": "#/$defs/postgresPassword" }, "minContains": 1, "maxContains": 1 },
    "exactlyOnePostgresObserverPassword": { "contains": { "$ref": "#/$defs/postgresObserverPassword" }, "minContains": 1, "maxContains": 1 },
    "exactlyOnePostgresContextPassword": { "contains": { "$ref": "#/$defs/postgresContextPassword" }, "minContains": 1, "maxContains": 1 },
    "exactlyOnePostgresAgentPassword": { "contains": { "$ref": "#/$defs/postgresAgentPassword" }, "minContains": 1, "maxContains": 1 },
    "exactlyOnePostgresMediaPassword": { "contains": { "$ref": "#/$defs/postgresMediaPassword" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneMariadbRootPassword": { "contains": { "$ref": "#/$defs/mariadbRootPassword" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneFrappeAdminPassword": { "contains": { "$ref": "#/$defs/frappeAdminPassword" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneFrappeDemoPassword": { "contains": { "$ref": "#/$defs/frappeDemoPassword" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneAgentApiBearer": { "contains": { "$ref": "#/$defs/agentApiBearer" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneContextApiBearer": { "contains": { "$ref": "#/$defs/contextApiBearer" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneContextClientBearer": { "contains": { "$ref": "#/$defs/contextClientBearer" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneCursorHmacKey": { "contains": { "$ref": "#/$defs/cursorHmacKey" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneTokenizerHmacKey": { "contains": { "$ref": "#/$defs/tokenizerHmacKey" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneMappingVaultKey": { "contains": { "$ref": "#/$defs/mappingVaultKey" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneTrustedPhraseLexicon": { "contains": { "$ref": "#/$defs/trustedPhraseLexicon" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneMediaRuntimeKey": { "contains": { "$ref": "#/$defs/mediaRuntimeKey" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneDeepseekApiKey": { "contains": { "$ref": "#/$defs/deepseekApiKey" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneFrappeMaterializerApiKey": { "contains": { "$ref": "#/$defs/frappeMaterializerApiKey" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneFrappeMaterializerApiSecret": { "contains": { "$ref": "#/$defs/frappeMaterializerApiSecret" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneIdentityHmacKey": { "contains": { "$ref": "#/$defs/identityHmacKey" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneFrappeIdentityResolverApiKey": { "contains": { "$ref": "#/$defs/frappeIdentityResolverApiKey" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneFrappeIdentityResolverApiSecret": { "contains": { "$ref": "#/$defs/frappeIdentityResolverApiSecret" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneEmailCredential": { "contains": { "$ref": "#/$defs/emailCredential" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneWecomCredential": { "contains": { "$ref": "#/$defs/wecomCredential" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneWhatsappCredential": { "contains": { "$ref": "#/$defs/whatsappCredential" }, "minContains": 1, "maxContains": 1 },
    "exactlyOneCloudflaredTunnel": { "contains": { "$ref": "#/$defs/cloudflaredTunnel" }, "minContains": 1, "maxContains": 1 }
  }
}
