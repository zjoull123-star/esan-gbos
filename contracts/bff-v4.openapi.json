      "IdentityPendingReview": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_case_ref", "review_case_revision", "status", "assigned_reviewer", "team_ref", "mapping_ref", "mapping_revision", "target", "evidence_refs", "policy_version"],
        "properties": {
          "review_case_ref": {"type": "string"},
          "review_case_revision": {"type": "integer", "minimum": 1},
          "status": {"const": "pending"},
          "assigned_reviewer": {"type": "string"},
          "team_ref": {"type": "string"},
          "mapping_ref": {"type": "string"},
          "mapping_revision": {"type": "integer", "minimum": 1},
          "target": {"$ref": "#/components/schemas/IdentityCandidate"},
          "evidence_refs": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
          "policy_version": {"type": "string"}
        }
      },
      "IdentitySubmitForReviewCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "identity_ref", "suggestion_key", "selected_candidate_type", "selected_candidate_ref", "assigned_reviewer", "expected_state", "expected_revision", "idempotency_key"],
        "allOf": [
          {
            "if": {"properties": {"expected_state": {"const": "unresolved"}}},
            "then": {"properties": {"expected_revision": {"const": 0}}}
          },
          {
            "if": {"properties": {"expected_state": {"const": "rejected"}}},
            "then": {"properties": {"expected_revision": {"minimum": 1}}}
          }
        ],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1, "maxLength": 48},
          "identity_ref": {"type": "string", "maxLength": 160},
          "suggestion_key": {"type": "string", "pattern": "^suggestion:v1:[a-f0-9]{64}$"},
          "selected_candidate_type": {"type": "string", "enum": ["User", "Party", "Contact"]},
          "selected_candidate_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "assigned_reviewer": {"type": "string", "minLength": 1, "maxLength": 140},
          "expected_state": {"type": "string", "enum": ["unresolved", "rejected"]},
          "expected_revision": {"type": "integer", "minimum": 0},
          "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 256}
        }
      },
      "IdentityRevokeCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "identity_ref", "mapping_ref", "expected_revision", "idempotency_key"],
        "properties": {
