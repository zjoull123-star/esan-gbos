{
  "openapi": "3.1.0",
  "info": {
    "title": "ESAN GBOS Local Channel and Model Pilot BFF",
    "version": "4.0.0",
    "description": "Frozen, role-scoped channel observation, connector control, model usage and AI draft review surface. Restricted source content is omitted unless explicitly authorized."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/method/esan_gbos.api.v4.integration.list_status": {
      "get": {
        "operationId": "integration.list_status",
        "x-gbos-cache": "no-store",
        "x-gbos-roles": ["Integration Admin", "GBOS Admin"],
        "security": [{"FrappeSession": []}],
        "parameters": [
          {"name": "channel", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/ConnectorListSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.integration.pause": {
      "post": {
        "operationId": "integration.pause",
        "x-gbos-cache": "no-store",
        "x-gbos-roles": ["Integration Admin", "GBOS Admin"],
        "security": [{"FrappeSession": [], "FrappeCsrf": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {"$ref": "#/components/schemas/ConnectorCommand"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/ConnectorCommandSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.integration.resume": {
      "post": {
        "operationId": "integration.resume",
        "x-gbos-cache": "no-store",
        "x-gbos-roles": ["Integration Admin", "GBOS Admin"],
        "security": [{"FrappeSession": [], "FrappeCsrf": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {"$ref": "#/components/schemas/ConnectorCommand"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/ConnectorCommandSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.integration.replay": {
      "post": {
        "operationId": "integration.replay",
        "x-gbos-cache": "no-store",
        "x-gbos-replay-scope": "eligible_failed_deliveries",
        "x-gbos-replay-limit": 100,
        "x-gbos-replay-requires": [
          "within_connector_replay_window",
          "not_retention_expired",
          "same_site_and_instance"
        ],
        "x-gbos-roles": ["Integration Admin", "GBOS Admin"],
        "security": [{"FrappeSession": [], "FrappeCsrf": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {"$ref": "#/components/schemas/ConnectorCommand"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/ConnectorCommandSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.communication.list": {
      "get": {
        "operationId": "communication.list",
        "x-gbos-cache": "no-store",
        "x-gbos-scope": "Server enforces current user and team scope",
        "x-gbos-roles": ["Sales Manager", "Sales User", "CEO", "GBOS Admin"],
        "security": [{"FrappeSession": []}],
        "parameters": [
          {"name": "channel", "in": "query", "schema": {"type": "string"}},
          {"name": "classification", "in": "query", "schema": {"type": "string"}},
          {"name": "review_status", "in": "query", "schema": {"type": "string"}},
          {"name": "cursor", "in": "query", "schema": {"type": "string"}},
          {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/CommunicationListSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.communication.get": {
      "get": {
        "operationId": "communication.get",
        "x-gbos-cache": "no-store",
        "x-gbos-scope": "Server enforces current user and team scope; Restricted source content is omitted by default",
        "x-gbos-roles": ["Sales Manager", "Sales User", "CEO", "GBOS Admin"],
        "security": [{"FrappeSession": []}],
        "parameters": [
          {"name": "observation_id", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/CommunicationDetailSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.model.get_usage": {
      "get": {
        "operationId": "model.get_usage",
        "x-gbos-cache": "no-store",
        "x-gbos-roles": ["Integration Admin", "GBOS Admin"],
        "security": [{"FrappeSession": []}],
        "parameters": [
          {"name": "period", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/ModelUsageSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.ai_draft.list": {
      "get": {
        "operationId": "ai_draft.list",
        "x-gbos-cache": "no-store",
        "x-gbos-roles": ["Reviewer", "GBOS Admin"],
        "security": [{"FrappeSession": []}],
        "parameters": [
          {"name": "status", "in": "query", "schema": {"type": "string", "enum": ["AI Draft", "Pending"]}},
          {"name": "cursor", "in": "query", "schema": {"type": "string"}},
          {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/AiDraftListSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.ai_draft.get": {
      "get": {
        "operationId": "ai_draft.get",
        "x-gbos-cache": "no-store",
        "x-gbos-roles": ["Reviewer", "GBOS Admin"],
        "security": [{"FrappeSession": []}],
        "parameters": [
          {"name": "draft_id", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/AiDraftDetailSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.ai_draft.submit_for_review": {
      "post": {
        "operationId": "ai_draft.submit_for_review",
        "x-gbos-cache": "no-store",
        "x-gbos-transition": "AI Draft -> Pending only",
        "x-gbos-roles": ["Reviewer", "GBOS Admin"],
        "security": [{"FrappeSession": [], "FrappeCsrf": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {"$ref": "#/components/schemas/AiDraftSubmitCommand"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/AiDraftDetailSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.identity.list_states": {
      "get": {
        "operationId": "identity.list_states",
        "x-gbos-cache": "no-store",
        "x-gbos-scope": "communication_and_same_team",
        "x-gbos-roles": ["Sales User", "Sales Manager", "Integration Admin", "GBOS Admin", "CEO"],
        "security": [{"FrappeSession": []}],
        "parameters": [
          {"name": "observation_id", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 48}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/IdentityStateListSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.identity.get_state": {
      "get": {
        "operationId": "identity.get_state",
        "x-gbos-cache": "no-store",
        "x-gbos-scope": "communication_and_same_team",
        "x-gbos-roles": ["Sales User", "Sales Manager", "Integration Admin", "GBOS Admin", "CEO"],
        "security": [{"FrappeSession": []}],
        "parameters": [
          {"name": "observation_id", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 48}},
          {"name": "identity_ref", "in": "query", "required": true, "schema": {"type": "string", "pattern": "^extid:v1:[a-z_]+:[A-Za-z0-9._~-]+$", "maxLength": 160}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/IdentityStateDetailSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.identity.list_candidates": {
      "get": {
        "operationId": "identity.list_candidates",
        "x-gbos-cache": "no-store",
        "x-gbos-scope": "communication_and_same_team",
        "x-gbos-roles": ["Sales User", "Sales Manager", "Integration Admin", "GBOS Admin", "CEO"],
        "x-gbos-candidate-policy": {
          "sales_roles": ["Sales User", "Sales Manager"],
          "sales_candidate_types": ["Party", "Contact"],
          "administrative_roles": ["Integration Admin", "GBOS Admin", "CEO"],
          "administrative_candidate_types": ["User", "Party", "Contact"],
          "mixed_role_precedence": "administrative"
        },
        "security": [{"FrappeSession": []}],
        "parameters": [
          {"name": "observation_id", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 48}},
          {"name": "identity_ref", "in": "query", "required": true, "schema": {"type": "string", "maxLength": 160}},
          {"name": "candidate_type", "in": "query", "required": true, "schema": {"type": "string", "enum": ["User", "Party", "Contact"]}},
          {"name": "search", "in": "query", "schema": {"type": "string", "maxLength": 100}},
          {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000}},
          {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/IdentityCandidateListSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.identity.list_pending_reviews": {
      "get": {
        "operationId": "identity.list_pending_reviews",
        "x-gbos-cache": "no-store",
        "x-gbos-scope": "assigned_reviewer_or_gbos_admin",
        "x-gbos-roles": ["Reviewer", "GBOS Admin"],
        "security": [{"FrappeSession": []}],
        "parameters": [
          {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000}},
          {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/IdentityReviewListSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.identity.get_pending_review": {
      "get": {
        "operationId": "identity.get_pending_review",
        "x-gbos-cache": "no-store",
        "x-gbos-scope": "assigned_reviewer_or_gbos_admin",
        "x-gbos-roles": ["Reviewer", "GBOS Admin"],
        "security": [{"FrappeSession": []}],
        "parameters": [
          {"name": "review_case_ref", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 140}}
        ],
        "responses": {
          "200": {"$ref": "#/components/responses/IdentityReviewDetailSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.identity.submit_for_review": {
      "post": {
        "operationId": "identity.submit_for_review",
        "x-gbos-cache": "no-store",
        "x-gbos-scope": "communication_and_same_team",
        "x-gbos-audit": "request_id_and_idempotency",
        "x-gbos-transition": [
          "unresolved -> AI Draft -> Pending",
          "Rejected Active -> AI Draft Active -> Pending Active"
        ],
        "x-gbos-roles": ["Sales User", "Sales Manager", "Integration Admin", "GBOS Admin", "CEO"],
        "x-gbos-candidate-policy": {
          "sales_roles": ["Sales User", "Sales Manager"],
          "sales_candidate_types": ["Party", "Contact"],
          "administrative_roles": ["Integration Admin", "GBOS Admin", "CEO"],
          "administrative_candidate_types": ["User", "Party", "Contact"],
          "mixed_role_precedence": "administrative"
        },
        "security": [{"FrappeSession": [], "FrappeCsrf": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {"$ref": "#/components/schemas/IdentitySubmitForReviewCommand"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/IdentityCommandSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/api/method/esan_gbos.api.v4.identity.revoke": {
      "post": {
        "operationId": "identity.revoke",
        "x-gbos-cache": "no-store",
        "x-gbos-scope": "communication_and_same_team",
        "x-gbos-audit": "request_id_and_idempotency",
        "x-gbos-transition": "Approved Active -> Approved Revoked",
        "x-gbos-roles": ["Integration Admin", "GBOS Admin"],
        "security": [{"FrappeSession": [], "FrappeCsrf": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {"$ref": "#/components/schemas/IdentityRevokeCommand"}
            }
          }
        },
        "responses": {
          "200": {"$ref": "#/components/responses/IdentityCommandSuccess"},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "FrappeSession": {"type": "apiKey", "in": "cookie", "name": "sid"},
      "FrappeCsrf": {"type": "apiKey", "in": "header", "name": "X-Frappe-CSRF-Token"}
    },
    "schemas": {
      "SuccessMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "schema_version"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "schema_version": {"const": "4.0"},
          "next_cursor": {"type": ["string", "null"]},
          "page_size": {"type": "integer", "minimum": 1, "maximum": 50},
          "replayed": {"type": "boolean"},
          "original_request_id": {"type": "string"}
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "request_id", "details"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "authentication_required",
                  "permission_denied",
                  "csrf_failed",
                  "method_not_allowed",
                  "invalid_dto",
                  "invalid_query",
                  "invalid_cursor",
                  "not_found",
                  "scope_mismatch",
                  "identity_mismatch",
                  "suggestion_mismatch",
                  "candidate_ineligible",
                  "candidate_type_forbidden",
                  "reviewer_ineligible",
                  "revision_conflict",
                  "invalid_transition",
                  "idempotency_conflict",
                  "request_in_progress",
                  "validation_error",
                  "internal_error"
                ]
              },
              "message": {"type": "string"},
              "request_id": {"type": "string"},
              "details": {"type": "object"}
            }
          }
        }
      },
      "FrappeErrorWire": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {"message": {"$ref": "#/components/schemas/ErrorEnvelope"}}
      },
      "ConnectorStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_id",
          "channel",
          "status",
          "checkpoint_version",
          "backlog",
          "last_success_at",
          "safe_error_code",
          "freshness",
          "revision"
        ],
        "properties": {
          "instance_id": {"type": "string"},
          "channel": {"type": "string"},
          "status": {"type": "string", "enum": ["enabled", "paused", "error", "disabled"]},
          "checkpoint_version": {"type": "integer", "minimum": 0},
          "backlog": {"type": "integer", "minimum": 0},
          "last_success_at": {"type": ["string", "null"], "format": "date-time"},
          "safe_error_code": {"type": ["string", "null"]},
          "freshness": {"type": "string", "enum": ["fresh", "stale", "unknown"]},
          "revision": {"type": "integer", "minimum": 0}
        }
      },
      "ConnectorCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "expected_revision", "idempotency_key"],
        "properties": {
          "instance_id": {"type": "string", "minLength": 1},
          "expected_revision": {"type": "integer", "minimum": 0},
          "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 256}
        }
      },
      "CommunicationSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "channel",
          "occurred_at",
          "summary_zh",
          "original_language",
          "classification",
          "review_status",
          "team_ref",
          "party_ref",
          "evidence_count"
        ],
        "properties": {
          "observation_id": {"type": "string"},
          "channel": {"type": "string"},
          "occurred_at": {"type": "string", "format": "date-time"},
          "summary_zh": {"type": "string"},
          "original_language": {"type": "string"},
          "classification": {"type": "string"},
          "review_status": {"type": "string"},
          "team_ref": {"type": ["string", "null"]},
          "party_ref": {"type": ["string", "null"]},
          "evidence_count": {"type": "integer", "minimum": 0}
        }
      },
      "EvidenceLocator": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "locator"],
        "properties": {
          "ref": {"type": "string"},
          "locator": {"type": "string"}
        }
      },
      "FactProposal": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "confidence", "type", "value_display"],
        "properties": {
          "status": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "type": {"type": "string"},
          "value_display": {"type": "string"}
        }
      },
      "AssociationSuggestion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "confidence", "suggestion_key"],
        "properties": {
          "type": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "suggestion_key": {"type": "string", "pattern": "^suggestion:v1:[a-f0-9]{64}$"}
        }
      },
      "ParticipantIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity_ref", "provider", "status"],
        "properties": {
          "identity_ref": {"type": "string", "pattern": "^extid:v1:[a-z_]+:[A-Za-z0-9._~-]+$", "maxLength": 160},
          "provider": {"type": "string", "enum": ["email", "wecom", "whatsapp", "phone", "manual_import"]},
          "status": {"type": "string", "enum": ["unresolved", "confirmed", "revoked"]},
          "mapping_ref": {"type": "string"},
          "mapping_revision": {"type": "integer", "minimum": 1},
          "target_type": {"type": "string", "enum": ["User", "Party"]}
        }
      },
      "ModelMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"const": "deepseek-v4-flash"},
          "version": {"type": "string"}
        }
      },
      "CommunicationDetail": {
        "unevaluatedProperties": false,
        "allOf": [
          {"$ref": "#/components/schemas/CommunicationSummary"},
          {
            "type": "object",
            "required": [
              "evidence",
              "fact_proposals",
              "association_suggestions",
              "participant_identities",
              "model",
              "raw_access_allowed"
            ],
            "properties": {
              "evidence": {"type": "array", "items": {"$ref": "#/components/schemas/EvidenceLocator"}},
              "fact_proposals": {"type": "array", "items": {"$ref": "#/components/schemas/FactProposal"}},
              "association_suggestions": {"type": "array", "items": {"$ref": "#/components/schemas/AssociationSuggestion"}},
              "participant_identities": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/ParticipantIdentity"}},
              "model": {"$ref": "#/components/schemas/ModelMetadata"},
              "raw_access_allowed": {"type": "boolean"},
              "original_text": {
                "type": "string",
                "description": "Conditionally returned only when raw_access_allowed is true and the role policy authorizes the source classification."
              }
            }
          }
        ]
      },
      "UsageCost": {
        "type": "object",
        "additionalProperties": false,
        "required": ["currency", "amount", "state"],
        "properties": {
          "currency": {"const": "USD"},
          "amount": {"type": ["number", "null"], "minimum": 0},
          "state": {"type": "string", "enum": ["known", "partial", "unknown"]}
        }
      },
      "ModelUsage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "period", "tokens", "token_state", "cost", "soft_limit_usd", "hard_limit_usd", "state"],
        "properties": {
          "model": {"const": "deepseek-v4-flash"},
          "period": {"type": "string"},
          "tokens": {"type": ["integer", "null"], "minimum": 0},
          "token_state": {"type": "string", "enum": ["known", "partial", "unknown"]},
          "cost": {"$ref": "#/components/schemas/UsageCost"},
          "soft_limit_usd": {"type": "number", "minimum": 0, "description": "Monthly warning threshold in USD."},
          "hard_limit_usd": {"type": "number", "exclusiveMinimum": 0, "description": "Monthly model-call stop threshold in USD."},
          "state": {"type": "string", "enum": ["normal", "soft_limit", "hard_limit", "unknown"]}
        }
      },
      "AiDraft": {
        "type": "object",
        "additionalProperties": false,
        "required": ["draft_id", "kind", "status", "origin", "subject", "evidence", "model", "revision"],
        "properties": {
          "draft_id": {"type": "string"},
          "kind": {"type": "string", "enum": ["Work Item", "Review Case", "CEO Informal Observation"]},
          "status": {"type": "string", "enum": ["AI Draft", "Pending"]},
          "origin": {"const": "AI"},
          "subject": {"type": "string"},
          "evidence": {"type": "array", "items": {"$ref": "#/components/schemas/EvidenceLocator"}},
          "model": {"$ref": "#/components/schemas/ModelMetadata"},
          "revision": {"type": "integer", "minimum": 0}
        }
      },
      "AiDraftSubmitCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": ["draft_id", "expected_revision", "idempotency_key"],
        "properties": {
          "draft_id": {"type": "string", "minLength": 1},
          "expected_revision": {"type": "integer", "minimum": 0},
          "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 256}
        }
      },
      "IdentityState": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity_ref", "provider", "status"],
        "properties": {
          "identity_ref": {"type": "string", "maxLength": 160},
          "provider": {"type": "string", "enum": ["email", "wecom", "whatsapp", "phone", "manual_import"]},
          "status": {"type": "string", "enum": ["unresolved", "proposed", "pending", "confirmed", "rejected", "revoked"]},
          "mapping_ref": {"type": "string"},
          "mapping_revision": {"type": "integer", "minimum": 1},
          "target_type": {"type": "string", "enum": ["User", "Party"]},
          "display_label": {"type": "string"}
        }
      },
      "ConnectorAccountOwner": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display_label"],
        "properties": {"display_label": {"type": "string"}}
      },
