{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/gate2/metric-definition.schema.json",
  "title": "MetricDefinition",
  "description": "A governed, versioned KPI definition for the Metrics API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metric_key",
    "display_name",
    "description",
    "definition_version",
    "owner",
    "unit",
    "aggregation",
    "window",
    "source_lineage",
    "exclusions",
    "reconciliation",
    "freshness_slo_seconds",
    "effective_at",
    "data_classification"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "metric_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{2,79}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "definition_version": {
      "$ref": "common.schema.json#/$defs/Version"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "aggregation": {
      "type": "string",
      "enum": [
        "sum",
        "count",
        "average",
        "ratio",
        "balance",
        "duration"
      ]
    },
    "window": {
      "$ref": "common.schema.json#/$defs/MetricWindow"
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/SourceLineage"
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "owner",
        "tolerance"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "freshness_slo_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "effective_at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "data_classification": {
      "$ref": "common.schema.json#/$defs/DataClassification"
    }
  }
}
