{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/gate5/metrics-dashboard.schema.json",
  "title": "Gate5MetricsDashboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "source_mode",
    "synthetic",
    "generated_at",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,139}$"
    },
    "source_mode": {
      "enum": [
        "synthetic",
        "live"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "metric-response.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_mode": {
            "const": "synthetic"
          }
        }
      },
      "then": {
        "properties": {
          "synthetic": {
            "const": true
          },
          "metrics": {
            "items": {
              "properties": {
                "source_mode": {
                  "const": "synthetic"
                },
                "synthetic": {
                  "const": true
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "synthetic": {
            "const": false
          },
          "metrics": {
            "items": {
              "properties": {
                "source_mode": {
                  "const": "live"
                },
                "synthetic": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  ]
}
