{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/v1/connector-checkpoint.schema.json",
  "title": "ConnectorCheckpoint",
  "description": "Durable ingestion cursor, replay window, and lease state for one connector.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "site_id",
    "connector",
    "replay_window_seconds",
    "status",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "connector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "cursor": {
      "type": "string",
      "maxLength": 4096
    },
    "replay_window_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31536000
    },
    "lease_owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_success_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error_code": {
      "type": "string",
      "maxLength": 80
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "paused",
        "degraded",
        "failed"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "dependentRequired": {
    "lease_owner": [
      "lease_expires_at"
    ],
    "lease_expires_at": [
      "lease_owner"
    ]
  }
}
