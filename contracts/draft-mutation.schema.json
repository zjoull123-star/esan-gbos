{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/v1/draft-mutation.schema.json",
  "title": "DraftMutation",
  "description": "A policy-constrained create or update that can only produce an internal AI Draft.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mutation_id",
    "site_id",
    "target_doctype",
    "operation",
    "target_review_status",
    "patch",
    "idempotency_key",
    "evidence_refs",
    "policy_version",
    "confidence",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mutation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "target_doctype": {
      "type": "string",
      "pattern": "^GBOS [A-Za-z0-9 ]+$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "create",
        "update"
      ]
    },
    "target_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target_review_status": {
      "const": "AI Draft"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "patch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "path"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "replace",
              "remove"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/(?!business_status(?:/|$)|review_status(?:/|$)|status(?:/|$)|deal(?:/|$)|deal_stage(?:/|$)|won_lost(?:/|$)|price(?:/|$)|unit_price(?:/|$)|formal_price(?:/|$)|discount(?:/|$)|payment_terms(?:/|$)|delivery_date(?:/|$)|selected_supplier(?:/|$)|outbound_message(?:/|$)|sales_order(?:/|$)|purchase_order(?:/|$)).+"
          },
          "value": true
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "update"
          }
        }
      },
      "then": {
        "required": [
          "target_name",
          "expected_revision"
        ]
      }
    }
  ]
}
