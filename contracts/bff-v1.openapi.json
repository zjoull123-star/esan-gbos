      },
      "Party360Data": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "organization",
          "contact",
          "lead",
          "deal",
          "product_briefs",
          "samples",
          "demands"
        ],
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/PartyProfileSummary"
          },
          "organization": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CRMOrganizationSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "contact": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ContactSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "lead": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CRMLeadSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "deal": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CRMDealSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "product_briefs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BusinessRecordSummary"
            }
          },
          "samples": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BusinessRecordSummary"
            }
          },
          "demands": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BusinessRecordSummary"
            }
          }
        }
      },
      "WorkItemData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title",
          "team",
          "assigned_to",
          "priority",
          "due_date",
          "origin",
          "business_status",
          "review_status",
          "revision",
          "reference_doctype",
          "reference_name",
          "modified"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/DocumentName"
          },
          "title": {
            "type": "string"
          },
          "team": {
            "$ref": "#/components/schemas/DocumentName"
          },
