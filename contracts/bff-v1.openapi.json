            ]
          }
        }
      },
      "BusinessRecordSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title",
          "origin",
          "business_status",
          "review_status",
          "revision"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/DocumentName"
          },
          "title": {
            "type": "string"
          },
          "deal": {
