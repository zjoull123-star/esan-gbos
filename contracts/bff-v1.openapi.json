              "string",
              "null"
            ]
          },
          "priority": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "type": "string"
          },
          "business_status": {
            "type": "string"
          },
          "review_status": {
            "type": "string"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "reference_doctype": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "modified": {
            "type": "string"
          }
        }
      },
      "WorkItemListData": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/WorkItemData"
        }
      },
      "SampleProjectSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title",
          "team",
          "party_profile",
          "product_brief",
          "origin",
          "business_status",
          "review_status",
          "revision",
          "modified"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/DocumentName"
          },
          "title": {
            "type": "string"
          },
          "team": {
