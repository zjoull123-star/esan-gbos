{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/gate4/action-proposal.schema.json",
  "title": "Gate4ActionProposal",
  "description": "An immutable proposal. It is not a DraftMutation, ApprovedCommand, or execution request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_proposal_id",
    "site_id",
    "processing_purpose",
    "proposal_version",
    "proposal_revision",
    "action_type",
    "status",
    "decision_ref",
    "fact_version_refs",
    "evidence_refs",
    "requested_by",
    "target_ref",
    "target_revision",
    "payload",
    "payload_digest",
    "policy_version",
    "created_at",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "action_proposal_id": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Identifier"
    },
    "site_id": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/SiteId"
    },
    "processing_purpose": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/ProcessingPurpose"
    },
    "proposal_version": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Version"
    },
    "proposal_revision": {
      "type": "integer",
      "minimum": 1
    },
    "action_type": {
      "type": "string",
      "enum": [
        "internal.ai_draft.propose",
        "internal.fact.propose",
        "internal.work_item.propose",
        "internal.review_case.propose",
        "internal.work_item.transition.propose"
      ]
    },
    "status": {
      "const": "proposed"
    },
    "decision_ref": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Identifier"
    },
    "fact_version_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://contracts.esan.example/gbos/gate4/common.schema.json#/$defs/FactVersionReference"
      }
    },
    "evidence_refs": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/EvidenceRefs"
    },
    "requested_by": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Identifier"
    },
    "target_ref": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Identifier"
    },
    "target_revision": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    },
    "payload_digest": {
      "$ref": "https://contracts.esan.example/gbos/gate4/common.schema.json#/$defs/Sha256"
    },
    "policy_version": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Version"
    },
    "created_at": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Timestamp"
    },
    "correlation_id": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Identifier"
    }
  }
}
