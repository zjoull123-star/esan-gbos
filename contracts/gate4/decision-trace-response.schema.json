{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/gate4/decision-trace-response.schema.json",
  "title": "DecisionTraceResponse",
  "description": "A Decision with the exact immutable proposal, fact versions, and evidence records it references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "decision",
    "proposal",
    "facts",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "site_id": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/SiteId"
    },
    "decision": {
      "$ref": "https://contracts.esan.example/gbos/gate4/decision-record.schema.json"
    },
    "proposal": {
      "allOf": [
        {
          "$ref": "https://contracts.esan.example/gbos/gate4/common.schema.json#/$defs/ProposalReference"
        },
        {
          "type": "object",
          "required": [
            "payload_digest"
          ],
          "properties": {
            "payload_digest": {
              "$ref": "https://contracts.esan.example/gbos/gate4/common.schema.json#/$defs/Sha256"
            }
          }
        }
      ]
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://contracts.esan.example/gbos/gate4/verified-business-fact.schema.json"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://contracts.esan.example/gbos/gate2/evidence-record.schema.json"
      }
    }
  }
}
