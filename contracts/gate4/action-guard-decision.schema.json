{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.esan.example/gbos/gate4/action-guard-decision.schema.json",
  "title": "ActionGuardDecision",
  "description": "A fail-closed policy result over one immutable proposal revision at one evaluation phase.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "guard_decision_id",
    "site_id",
    "processing_purpose",
    "proposal_ref",
    "proposal_version",
    "proposal_revision",
    "target_revision",
    "evaluation_phase",
    "outcome",
    "policy_version",
    "reason_codes",
    "evidence_refs",
    "evaluated_at",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "guard_decision_id": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Identifier"
    },
    "site_id": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/SiteId"
    },
    "processing_purpose": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/ProcessingPurpose"
    },
    "proposal_ref": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Identifier"
    },
    "proposal_version": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Version"
    },
    "proposal_revision": {
      "type": "integer",
      "minimum": 1
    },
    "target_revision": {
      "type": "integer",
      "minimum": 0
    },
    "evaluation_phase": {
      "type": "string",
      "enum": [
        "pre_tool",
        "post_result"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "allow",
        "require_human",
        "deny"
      ]
    },
    "policy_version": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Version"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "evidence_refs": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/EvidenceRefs"
    },
    "evaluated_at": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Timestamp"
    },
    "correlation_id": {
      "$ref": "https://contracts.esan.example/gbos/gate2/common.schema.json#/$defs/Identifier"
    }
  }
}
